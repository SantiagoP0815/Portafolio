---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allProjects = await getCollection('projects');
const allWriteups  = await getCollection('writeups');

const skillCategories = [
  {
    titulo: 'Ofensiva',
    color: 'cyan', icon: '⚔️',
    skills: ['Nmap', 'SQLMap', 'John / Hashcat', 'Evil-WinRM', 'Netcat', 'Reverse Shells']
  },
  {
    titulo: 'Reconocimiento',
    color: 'green', icon: '🔍',
    skills: ['Gobuster / Dirbuster', 'Wireshark / TShark', 'SMB Enumeration', 'FTP Enumeration', 'Redis Enumeration', 'Subdomain Discovery', 'JS Scraping', 'Web Crawling']
  },
  {
    titulo: 'Desarrollo Seguro',
    color: 'orange', icon: '🛠️',
    skills: ['Python', 'Bash', 'JavaScript / Node.js', 'Express', 'MySQL', 'Git / GitHub', 'Docker (básico)', 'REST APIs']
  },
  {
    titulo: 'Defensiva',
    color: 'purple', icon: '🛡️',
    skills: ['Hardening HTTP Headers', 'CSRF Protection', 'Rate Limiting', 'XSS Prevention', 'SQLi Prevention', 'Input Sanitization', 'Helmet.js', 'OWASP Top 10']
  },
];

const metodologia = [
  { fase: 'Reconocimiento', color: 'cyan', desc: 'Enumeración de puertos, servicios, subdominios y tecnologías con Nmap, Gobuster y scripts personalizados.' },
  { fase: 'Foothold',       color: 'green', desc: 'Acceso inicial mediante vulnerabilidades identificadas: SQLi, credenciales débiles, archivos expuestos.' },
  { fase: 'Explotación',    color: 'orange', desc: 'Explotación de servicios, obtención de shells inversas y pivoting entre sistemas.' },
  { fase: 'Escalada',       color: 'purple', desc: 'Elevación a root/Administrator mediante abuso de permisos, binarios SUID y tareas programadas.' },
  { fase: 'Reporte',        color: 'pink', desc: 'Documentación técnica detallada con pasos de reproducción, herramientas utilizadas y recomendaciones.' },
];

const objetivos = [
  { icon: '🔐', titulo: 'CompTIA Security+',     desc: 'Tras completar las certificaciones NSE',      color: 'orange', tag: 'pendiente'   },
  { icon: '⚔️', titulo: 'eJPT',                  desc: 'Siguiente paso en seguridad ofensiva',      color: 'purple', tag: 'pendiente'   },
  { icon: '🏆', titulo: 'HackTheBox Ranking',     desc: 'Mejorar ranking global activo',             color: 'orange', tag: 'en progreso' },
  { icon: '💻', titulo: 'Open Source',            desc: 'Contribuir a proyectos de ciberseguridad', color: 'cyan',   tag: 'pendiente'   },
];
---

<Layout
  title="Carlos Santiago Patiño Reyes | Ciberseguridad"
  description="Portafolio de Carlos Santiago Patiño Reyes, Ingeniero de Sistemas especializado en Ciberseguridad, Ethical Hacking y CTF."
>
  <div class="whoami-page">
    <div class="body-cols">

      <!-- ══ Columna izquierda ══════════════════════════════ -->
      <div class="col-left">

        <!-- Profile header -->
        <header class="profile-header animate-fade-in-up">
          <div class="whoami-chip">
            <span class="chip-prompt font-mono">$</span>
            <span class="chip-cmd font-mono">whoami</span>
            <span class="chip-cursor"></span>
          </div>
          <h1 class="profile-name">
            <span class="name-line">Carlos Santiago</span>
            <span class="name-line neon-cyan name-line--last">Patiño Reyes</span>
          </h1>
          <p class="profile-role font-mono">Ingeniero de Sistemas · Aspirante Junior en Ciberseguridad</p>
          <div class="profile-cta">
            <a href={`${base}/projects`} class="btn-primary">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3"/>
              </svg>
              Proyectos
            </a>
            <a href={`${base}/writeups`} class="btn-primary">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/>
              </svg>
              Writeups CTF
            </a>
            <a href={`${base}/cv`} class="btn-primary">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
              </svg>
              CV
            </a>
            <div class="profile-social-row">
            <a href="https://github.com/SantiagoP0815" target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
              </svg>
              GitHub
            </a>
            <a href="https://linkedin.com/in/carlos-santiago-patino-reyes" target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </div>
          </div>
        </header>

        <!-- Sobre mí -->
        <section class="whoami-section animate-fade-in-up animate-delay-100">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> sobre_mí</h2>
          <p class="bio-text">
            Ingeniero de Sistemas e Informática egresado de la <strong>Universidad Pontificia Bolivariana — Seccional Bucaramanga</strong>, con formación dual en ciberseguridad ofensiva y defensiva. Combino pentesting estructurado (OWASP Top 10) con hardening de aplicaciones web, aplicando controles como CSRF protection, XSS/SQLi prevention y rate limiting.
            Cuento con <strong>{allWriteups.length} máquinas resueltas</strong> en HackTheBox documentadas con writeups técnicos y <strong>{allProjects.length} proyectos</strong> de seguridad publicados en GitHub, incluyendo un gestor de CVs con seguridad integrada como proyecto de grado.
            Busco mi primera oportunidad profesional en ciberseguridad — idealmente en equipos <strong>Blue Team</strong> o <strong>AppSec</strong> — donde pueda aplicar ambos enfoques, seguir aprendiendo y contribuir a la protección de infraestructuras.
          </p>
          <div class="info-grid">
            <div class="info-card card-cyber info-card--green">
              <span class="info-card-icon">💼</span>
              <div class="info-card-body">
                <span class="info-card-label font-mono">Estado</span>
                <span class="info-card-value">DISPONIBLE</span>
                <span class="info-card-sub font-mono">Abierto a oportunidades</span>
              </div>
            </div>
            <div class="info-card card-cyber info-card--purple">
              <span class="info-card-icon">⚔️</span>
              <div class="info-card-body">
                <span class="info-card-label font-mono">CTF & Hacking</span>
                <span class="info-card-value">{allWriteups.length} WRITEUPS</span>
                <span class="info-card-sub font-mono">HackTheBox · Starting Point</span>
              </div>
            </div>
            <div class="info-card card-cyber info-card--cyan">
              <span class="info-card-icon">🛠️</span>
              <div class="info-card-body">
                <span class="info-card-label font-mono">Proyectos</span>
                <span class="info-card-value">{allProjects.length} ACTIVOS</span>
                <span class="info-card-sub font-mono">Seguridad & Desarrollo</span>
              </div>
            </div>
            <div class="info-card card-cyber info-card--purple">
              <span class="info-card-icon">🇬🇧</span>
              <div class="info-card-body">
                <span class="info-card-label font-mono">Inglés</span>
                <span class="info-card-value">NIVEL B2</span>
                <span class="info-card-sub font-mono">Lectura técnica fluida</span>
              </div>
            </div>
            <div class="info-card card-cyber info-card--green">
              <span class="info-card-icon">📍</span>
              <div class="info-card-body">
                <span class="info-card-label font-mono">Ubicación</span>
                <span class="info-card-value">Bucaramanga, Colombia</span>
                <span class="info-card-sub font-mono">Disponible remotamente</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Skills -->
        <section class="whoami-section animate-fade-in-up animate-delay-200">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> skills</h2>
          <div class="skills-categories">
            {skillCategories.map(cat => (
              <div class="skill-cat">
                <h3 class={`skill-cat-title font-mono cat-${cat.color}`}>
                  <span>{cat.icon}</span> {cat.titulo}
                </h3>
                <div class="skills-wrap">
                  {cat.skills.map(s => (
                    <span class={`tag-badge tag-${cat.color}`}>{s}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Metodología -->
        <section class="whoami-section animate-fade-in-up animate-delay-300">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> metodología</h2>
          <div class="metodologia-list">
            {metodologia.map((m, i) => (
              <div class="metodologia-item">
                <span class={`metodologia-num tag-${m.color}`}>{i + 1}</span>
                <div class="metodologia-body">
                  <span class={`metodologia-fase font-mono cat-${m.color}`}>{m.fase}</span>
                  <span class="metodologia-desc">{m.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- ══ Columna derecha ════════════════════════════════ -->
      <div class="col-right">

        <!-- Títulos -->
        <section class="whoami-section animate-fade-in-up animate-delay-100">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> títulos</h2>
          <div class="card-list">
            <div class="item-card card-cyber">
              <div class="item-icon">🎓</div>
              <div class="item-body">
                <div class="item-name">Ingeniero de Sistemas e Informática</div>
                <div class="item-inst font-mono">Universidad Pontificia Bolivariana</div>
                <div class="item-meta font-mono">Seccional Bucaramanga · Graduado</div>
              </div>
              <span class="tag-badge tag-cyan item-tag">ing. sistemas</span>
            </div>
            <div class="item-card card-cyber">
              <div class="item-icon">📋</div>
              <div class="item-body">
                <div class="item-name">Proyecto de Grado — Sistema de Gestión de CVs</div>
                <div class="item-inst font-mono">Node.js · Express · MySQL · Seguridad Integrada</div>
                <div class="item-meta font-mono">Helmet · CSRF · Rate Limiting · XSS/SQLi Prevention</div>
              </div>
              <span class="tag-badge tag-green item-tag">proyecto</span>
            </div>
          </div>
        </section>

        <!-- Certificaciones -->
        <section class="whoami-section animate-fade-in-up animate-delay-200">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> certificaciones</h2>
          <div class="card-list">
            <div class="item-card card-cyber">
              <div class="item-icon">🏅</div>
              <div class="item-body">
                <div class="item-name">Bootcamp Ciberseguridad Nivel Intermedio</div>
                <div class="item-inst font-mono">MINTIC · Talento Tech</div>
                <div class="item-meta font-mono">159 horas · Completado</div>
              </div>
              <span class="tag-badge tag-green item-tag">completado</span>
            </div>
            <div class="item-card card-cyber">
              <div class="item-icon">🎓</div>
              <div class="item-body">
                <div class="item-name">Fortinet NSE 1 · 2 · 3</div>
                <div class="item-inst font-mono">Fortinet Training Institute</div>
                <div class="item-meta font-mono">En curso · certificación gratuita de fundamentos</div>
              </div>
              <span class="tag-badge tag-orange item-tag">en progreso</span>
            </div>
          </div>
        </section>  

        <!-- Áreas de Interés -->
        <section class="whoami-section animate-fade-in-up animate-delay-300">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> áreas_de_interés</h2>
          <div class="card-list">
            <div class="item-card card-cyber">
              <div class="item-icon">🛡️</div>
              <div class="item-body">
                <div class="item-name">Blue Team &amp; Hardening</div>
                <div class="item-meta font-mono">CSRF · XSS/SQLi Prevention · Rate Limiting · HTTP Headers</div>
              </div>
              <span class="tag-badge tag-purple item-tag">defensivo</span>
            </div>
            <div class="item-card card-cyber">
              <div class="item-icon">🖥️</div>
              <div class="item-body">
                <div class="item-name">Pentesting Web</div>
                <div class="item-meta font-mono">OWASP Top 10 · Burp Suite · SQLi · XSS · CSRF</div>
              </div>
              <span class="tag-badge tag-cyan item-tag">ofensivo</span>
            </div>
            <div class="item-card card-cyber">
              <div class="item-icon">🔍</div>
              <div class="item-body">
                <div class="item-name">Análisis de Vulnerabilidades</div>
                <div class="item-meta font-mono">Escaneo automatizado · Revisión manual · Reportes</div>
              </div>
              <span class="tag-badge tag-green item-tag">defensivo</span>
            </div>
            <div class="item-card card-cyber">
              <div class="item-icon">🛠️</div>
              <div class="item-body">
                <div class="item-name">Desarrollo de Herramientas de Seguridad</div>
                <div class="item-meta font-mono">Python · Bash · Automatización de tareas</div>
              </div>
              <span class="tag-badge tag-orange item-tag">desarrollo</span>
            </div>
          </div>
        </section>

        <!-- Idiomas -->
        <section class="whoami-section animate-fade-in-up animate-delay-400">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> idiomas</h2>
          <div class="card-list">
            <div class="item-card card-cyber">
              <div class="item-icon">🇪🇸</div>
              <div class="item-body">
                <div class="item-name">Español</div>
                <div class="item-meta font-mono">Nativo</div>
              </div>
              <span class="tag-badge tag-green item-tag">nativo</span>
            </div>
            <div class="item-card card-cyber">
              <div class="item-icon">🇬🇧</div>
              <div class="item-body">
                <div class="item-name">Inglés — B2</div>
                <div class="item-meta font-mono">Lectura técnica fluida · Comunicación intermedia</div>
              </div>
              <span class="tag-badge tag-cyan item-tag">B2</span>
            </div>
          </div>
        </section>

        <!-- Próximos objetivos -->
        <section class="whoami-section animate-fade-in-up animate-delay-300">
          <h2 class="subsection-title font-mono"><span class="title-cursor">$</span> próximos_objetivos</h2>
          <div class="card-list">
            {objetivos.map(obj => (
              <div class="item-card card-cyber">
                <div class="item-icon">{obj.icon}</div>
                <div class="item-body">
                  <div class="item-name">{obj.titulo}</div>
                  <div class="item-meta font-mono">{obj.desc}</div>
                </div>
                <span class={`tag-badge tag-${obj.color} item-tag`}>{obj.tag}</span>
              </div>
            ))}
          </div>
        </section>

      </div>
    </div>
  </div>
</Layout>

<style>
  /* ── Page wrapper ────────────────────────────────────────── */
  .whoami-page {
    padding: 3rem 3rem 5rem 2rem;
  }

  /* ── Two-column layout ───────────────────────────────────── */
  .body-cols {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2.5rem;
    align-items: start;
    max-width: 74rem;
    margin: 0 auto;
  }
  .col-left,
  .col-right {
    min-width: 0;
  }
  @media (max-width: 768px) {
    .body-cols { grid-template-columns: 1fr; gap: 0; }
  }

  /* ── Profile header ──────────────────────────────────────── */
  .profile-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2.25rem;
    margin-bottom: 2.25rem;
    position: relative;
  }
  .profile-header::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(34,211,238,0.2), transparent 70%);
  }
  .whoami-chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    padding: 0.3rem 0.75rem;
    width: fit-content;
  }
  .chip-prompt {
    font-size: 0.7rem;
    color: var(--color-neon-green);
  }
  .chip-cmd {
    font-size: 0.7rem;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
  }
  .chip-cursor {
    width: 6px; height: 12px;
    background: var(--color-neon-cyan);
    animation: cursor-blink 1s step-end infinite;
    border-radius: 1px;
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  .profile-name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    display: flex; flex-direction: column;
  }
  .name-line { display: block; }
  .name-line--last {
    text-shadow: 0 0 20px rgba(34,211,238,0.3);
  }
  .profile-role {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
    border-left: 2px solid var(--color-neon-cyan);
    padding-left: 0.75rem;
  }
  .profile-cta {
    display: flex; flex-wrap: wrap; gap: 0.55rem;
    margin-top: 0.25rem;
  }
  .profile-social-row {
    display: flex; flex-wrap: wrap; gap: 0.55rem;
    width: 100%;
  }

  /* ── Subsections ─────────────────────────────────────────── */
  .whoami-section { margin-bottom: 2.5rem; }
  .subsection-title {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-neon-cyan);
    margin-bottom: 1.1rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .subsection-title::after {
    content: '';
    flex: 1; height: 1px;
    background: linear-gradient(90deg, rgba(34,211,238,0.25), transparent);
  }
  .title-cursor {
    display: inline-block;
    width: 0.55rem;
    height: 0.75rem;
    background: var(--color-neon-cyan);
    animation: cursor-blink 1s step-end infinite;
    border-radius: 1px;
    flex-shrink: 0;
  }

  /* ── Bio ─────────────────────────────────────────────────── */
  .bio-text {
    font-size: 0.93rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    background: rgba(255,255,255,0.015);
    position: relative;
  }
  .bio-text::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, rgba(34,211,238,0.2), transparent 60%);
  }
  .bio-text strong { color: var(--color-text-primary); font-weight: 600; }

  /* ── Info grid ───────────────────────────────────────────── */
  .info-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .info-card {
    flex: 0 1 200px;
    min-width: 160px;
    display: flex; align-items: flex-start; gap: 0.7rem;
    padding: 0.8rem 0.9rem; border-radius: 0.7rem;
