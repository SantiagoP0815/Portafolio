---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WriteupCard from '../components/WriteupCard.astro';
import CVManagerCard from '../components/CVManagerCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch and sort content
const allProyectos = await getCollection('proyectos');
const allWriteups = await getCollection('writeups');

const proyectosRecientes = allProyectos
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .filter(p => p.data.titulo !== 'Sistema de Gestión de CVs')
  .slice(0, 3);

const writeupsRecientes = allWriteups
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 2);
---

<Layout 
  title="SecPortfolio | Ciberseguridad & Ethical Hacking"
  description="Portafolio de ciberseguridad — CTF writeups, proyectos de pentesting y desarrollo seguro."
>

  <!-- ── Hero Section ── -->
  <section class="hero-section grid-bg">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <div class="max-w-2xl">
        <!-- Terminal prompt -->
        <div class="terminal-prompt mb-6">
          <span style="color: var(--color-neon-green)">user@kali</span>
          <span style="color: var(--color-text-muted)">:</span>
          <span style="color: var(--color-neon-cyan)">~/portfolio</span>
          <span style="color: var(--color-text-muted)">$</span>
          <span style="color: var(--color-text-primary)"> whoami</span>
        </div>

        <!-- Main heading -->
        <h1 class="hero-title animate-fade-in-up">
          Sec<span class="neon-cyan">Portfolio</span>
        </h1>
        <p class="hero-subtitle animate-fade-in-up animate-delay-100">
          Ciberseguridad · Pentesting · CTF · Desarrollo Seguro
        </p>
        <p class="hero-description animate-fade-in-up animate-delay-200">
          Hola. Soy un entusiasta de la ciberseguridad que documenta su aprendizaje 
          a través de writeups, proyectos de seguridad y desarrollo de herramientas. 
          Aquí encontrarás mi proceso de pensamiento y mis soluciones.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-3 mt-8 animate-fade-in-up animate-delay-300">
          <a href={`${base}/proyectos`} class="btn-primary">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3"/>
            </svg>
            Ver Proyectos
          </a>
          <a href={`${base}/writeups`} class="btn-ghost">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
            </svg>
            Writeups
          </a>
        </div>

        <!-- Stats row -->
        <div class="stats-row animate-fade-in-up animate-delay-400">
          <div class="stat-item">
            <span class="stat-number neon-cyan">{allProyectos.length}</span>
            <span class="stat-label">Proyectos</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number neon-green">{allWriteups.length}</span>
            <span class="stat-label">Writeups</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number neon-purple">HTB</span>
            <span class="stat-label">Plataformas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CV Manager Featured ── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="section-header">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest" style="color: var(--color-neon-cyan)">
        // proyecto_destacado
      </h2>
    </div>
    <CVManagerCard />
  </section>

  <!-- ── Recent Projects ── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="section-header">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest" style="color: var(--color-neon-cyan)">
        // proyectos_recientes
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {proyectosRecientes.map((p, i) => (
        <div style={`animation-delay: ${i * 0.1}s; opacity: 0`} class="animate-fade-in-up">
          <ProjectCard
            titulo={p.data.titulo}
            descripcion={p.data.descripcion}
            herramientas={p.data.herramientas}
            categoria={p.data.categoria}
            fecha={p.data.fecha}
            estado={p.data.estado}
            slug={p.id}
            github={p.data.github}
            demo={p.data.demo}
          />
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href={`${base}/proyectos`} class="btn-ghost">
        Ver todos los proyectos →
      </a>
    </div>
  </section>

  <!-- ── Recent Writeups ── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="section-header">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest" style="color: var(--color-neon-green)">
        // writeups_recientes
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {writeupsRecientes.map((w, i) => (
        <div style={`animation-delay: ${i * 0.15}s; opacity: 0`} class="animate-fade-in-up">
          <WriteupCard
            titulo={w.data.titulo}
            descripcion={w.data.descripcion}
            dificultad={w.data.dificultad}
            herramientas={w.data.herramientas}
            categoria={w.data.categoria}
            plataforma={w.data.plataforma}
            fecha={w.data.fecha}
            slug={w.id}
          />
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href={`${base}/writeups`} class="btn-ghost">
        Ver todos los writeups →
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero-section {
    min-height: 80vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .hero-section::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0,245,255,0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  .terminal-prompt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.375rem;
    padding: 0.5rem 1rem;
    width: fit-content;
  }
  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }
  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }
  .hero-description {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 55ch;
  }

  /* Stats */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1rem 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    width: fit-content;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-number {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border-subtle);
  }
</style>
