---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allProjects = await getCollection('projects');
const allWriteups  = await getCollection('writeups');
const spCount      = allWriteups.filter(w => w.data.startingPoint).length;
const retiredCount = allWriteups.length - spCount;
const retiredLabel = `${retiredCount} máquina${retiredCount === 1 ? '' : 's'} retirada${retiredCount === 1 ? '' : 's'}`;

const skillCategories = [
  {
    titulo: 'Defensiva',
    color: 'purple', icon: '🛡️',
    skills: ['OWASP Top 10', 'Hardening HTTP Headers', 'CSRF Protection', 'Rate Limiting', 'XSS / SQLi Prevention', 'Input Sanitization', 'Helmet.js']
  },
  {
    titulo: 'Infraestructura y Redes',
    color: 'green', icon: '🌐',
    skills: ['TCP/IP', 'DNS / DHCP', 'Subnetting', 'Windows', 'Linux (terminal)', 'VirtualBox / VMware', 'Wireshark / TShark']
  },
  {
    titulo: 'Pentesting y Reconocimiento',
    color: 'cyan', icon: '🔍',
    skills: ['Nmap', 'Gobuster', 'SQLMap', 'John / Hashcat', 'Evil-WinRM', 'Netcat', 'SMB / FTP / Redis Enumeration']
  },
  {
    titulo: 'Desarrollo y Automatización',
    color: 'orange', icon: '🛠️',
    skills: ['Python', 'Bash', 'JavaScript / Node.js', 'Express', 'MySQL', 'Git / GitHub', 'Docker (básico)']
  },
];

const metodologia = [
  { fase: 'Reconocimiento', color: 'cyan', desc: 'Enumeración de puertos, servicios y tecnologías con Nmap, Gobuster y scripts propios.' },
  { fase: 'Foothold',       color: 'green', desc: 'Acceso inicial mediante vulnerabilidades identificadas: SQLi, IDOR, credenciales débiles, archivos expuestos.' },
  { fase: 'Explotación',    color: 'orange', desc: 'Explotación de servicios mal configurados y obtención de shells inversas.' },
  { fase: 'Escalada',       color: 'purple', desc: 'Elevación a root/Administrator mediante abuso de permisos, binarios SUID y credenciales reutilizadas.' },
  { fase: 'Reporte',        color: 'pink', desc: 'Documentación técnica con pasos de reproducción, evidencias y recomendaciones de mitigación.' },
];

const objetivos = [
  { icon: '🎓', titulo: 'Fortinet NSE 1 · 2 · 3',              desc: 'Fundamentos de ciberseguridad',                         color: 'orange', tag: 'en progreso' },
  { icon: '🔐', titulo: 'ISC2 Certified in Cybersecurity (CC)', desc: 'Certificación de entrada reconocida por la industria',    color: 'purple', tag: 'siguiente'   },
  { icon: '🛡️', titulo: 'Laboratorio SOC con Wazuh',           desc: 'Detección de ataques, análisis de logs y triage de alertas', color: 'cyan', tag: 'siguiente'   },
  { icon: '📊', titulo: 'Labs Blue Team',                       desc: 'LetsDefend / Blue Team Labs Online: análisis de incidentes', color: 'green', tag: 'pendiente' },
];
---

<Layout
  title="Carlos Santiago Patiño Reyes | Ciberseguridad"
  description="Portafolio de Carlos Santiago Patiño Reyes, Ingeniero de Sistemas especializado en Ciberseguridad, Ethical Hacking y CTF."
>
  <div class="whoami-page">
    <div class="body-cols">

      <!-- ══ Columna izquierda ══════════════════════════════ -->
      <div class="col-left">

        <!-- Profile header -->
        <header class="profile-header animate-fade-in-up">
          <div class="whoami-chip">
            <span class="chip-prompt font-mono">$</span>
            <span class="chip-cmd font-mono">whoami</span>
            <span class="chip-cursor"></span>
          </div>
          <h1 class="profile-name">
            <span class="name-line">Carlos Santiago</span>
            <span class="name-line neon-cyan name-line--last">Patiño Reyes</span>
          </h1>
          <p class="profile-role font-mono">Ingeniero de Sistemas · Analista de Ciberseguridad Junior (SOC / Blue Team)</p>
          <div class="profile-cta">
            <a href={`${base}/projects`} class="btn-primary">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3"/>
              </svg>
              Proyectos
            </a>
