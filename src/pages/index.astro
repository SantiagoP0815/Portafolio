---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WriteupCard from '../components/WriteupCard.astro';
import CVManagerCard from '../components/CVManagerCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allProyectos = await getCollection('proyectos');
const allWriteups  = await getCollection('writeups');

const proyectosRecientes = allProyectos
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .filter(p => p.data.titulo !== 'Sistema de Gestión de CVs')
  .slice(0, 3);

const writeupsRecientes = allWriteups
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 2);
---

<Layout
  title="Carlos Santiago Patiño Reyes | Ciberseguridad"
  description="Portafolio de Carlos Santiago Patiño Reyes, Ingeniero de Sistemas especializado en Ciberseguridad, Ethical Hacking y CTF."
>

  <!-- ── Hero ── -->
  <section class="hero-section grid-bg">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32">
      <div class="hero-inner">

        <!-- Left: Text -->
        <div class="hero-text">
          <!-- Terminal chip -->
          <div class="terminal-chip animate-fade-in-up">
            <span class="chip-dot"></span>
            <span class="chip-label font-mono">whoami</span>
          </div>

          <h1 class="hero-name animate-fade-in-up animate-delay-100">
            Carlos Santiago<br />
            <span class="neon-cyan">Patiño Reyes</span>
          </h1>

          <p class="hero-role animate-fade-in-up animate-delay-200">
            Ingeniero de Sistemas &amp; Ciberseguridad
          </p>

          <p class="hero-desc animate-fade-in-up animate-delay-300">
            Graduado de la <strong>Universidad Pontificia Bolivariana — Seccional Bucaramanga</strong>.
            Apasionado por la seguridad ofensiva, el Ethical Hacking y el desarrollo de herramientas seguras.
            Actualmente preparándome para la certificación <span class="cert-badge">CompTIA Security+</span>.
          </p>

          <!-- CTA -->
          <div class="hero-cta animate-fade-in-up animate-delay-400">
            <a href={`${base}/proyectos`} class="btn-primary">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3"/>
              </svg>
              Ver Proyectos
            </a>
            <a href={`${base}/writeups`} class="btn-ghost">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
              </svg>
              Writeups CTF
            </a>
          </div>
        </div>

        <!-- Right: Stats card -->
        <div class="hero-card animate-fade-in-up animate-delay-300 animate-float">
          <div class="card-cyber stat-card">
            <div class="stat-card-header">
              <span class="font-mono text-xs" style="color: var(--color-text-muted)"># estadísticas</span>
            </div>
            <div class="stat-grid">
              <div class="stat-block">
                <span class="stat-num neon-cyan">{allProyectos.length}</span>
                <span class="stat-lbl">Proyectos</span>
              </div>
              <div class="stat-block">
                <span class="stat-num neon-green">{allWriteups.length}</span>
                <span class="stat-lbl">Writeups</span>
              </div>
              <div class="stat-block">
                <span class="stat-num neon-purple">HTB</span>
                <span class="stat-lbl">HackTheBox</span>
              </div>
              <div class="stat-block">
                <span class="stat-num" style="color: var(--color-neon-orange)">Sec+</span>
                <span class="stat-lbl">En curso</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Sobre mí / Logros ── -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="section-header">
      <h2 class="section-title font-mono">sobre_mí</h2>
    </div>

    <div class="about-grid">
      <!-- Info personal -->
      <div class="card-cyber about-card">
        <div class="about-card-icon">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
        </div>
        <h3 class="about-card-title">Perfil Personal</h3>
        <ul class="about-list">
          <li>
            <span class="about-dot cyan"></span>
            <span><strong>Carlos Santiago Patiño Reyes</strong></span>
          </li>
          <li>
            <span class="about-dot cyan"></span>
            <span>Ingeniero de Sistemas e Informática</span>
          </li>
          <li>
            <span class="about-dot cyan"></span>
            <span>UPB — Seccional Bucaramanga</span>
          </li>
          <li>
            <span class="about-dot cyan"></span>
            <span>Bucaramanga, Colombia</span>
          </li>
          <li>
            <span class="about-dot green"></span>
            <span>Disponible para oportunidades</span>
          </li>
        </ul>
      </div>

      <!-- Logros -->
      <div class="card-cyber about-card">
        <div class="about-card-icon" style="color: var(--color-neon-green)">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0"/>
          </svg>
        </div>
        <h3 class="about-card-title">Logros y Formación</h3>
        <ul class="about-list">
          <li>
            <span class="about-dot green"></span>
            <span>🎓 Graduado en Ing. de Sistemas e Informática — UPB Bucaramanga</span>
          </li>
          <li>
            <span class="about-dot green"></span>
            <span>📚 Estudiando <strong>CompTIA Security+</strong> (en proceso)</span>
          </li>
          <li>
            <span class="about-dot green"></span>
            <span>🔐 CTF Player — HackTheBox, TryHackMe</span>
          </li>
          <li>
            <span class="about-dot green"></span>
            <span>🛠️ {allProyectos.length} proyectos de seguridad desarrollados</span>
          </li>
          <li>
            <span class="about-dot green"></span>
            <span>📝 {allWriteups.length} writeups técnicos publicados</span>
          </li>
        </ul>
      </div>

      <!-- Skills -->
      <div class="card-cyber about-card about-card-wide">
        <div class="about-card-icon" style="color: var(--color-neon-purple)">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/>
          </svg>
        </div>
        <h3 class="about-card-title">Áreas de Expertise</h3>
        <div class="skills-grid">
          <span class="tag-badge tag-cyan">Ethical Hacking</span>
          <span class="tag-badge tag-cyan">Pentesting</span>
          <span class="tag-badge tag-green">CTF Challenges</span>
          <span class="tag-badge tag-green">OSINT</span>
          <span class="tag-badge tag-purple">Desarrollo Seguro</span>
          <span class="tag-badge tag-purple">Python</span>
          <span class="tag-badge tag-orange">Linux</span>
          <span class="tag-badge tag-orange">Redes</span>
          <span class="tag-badge tag-pink">CompTIA Sec+</span>
          <span class="tag-badge tag-pink">Criptografía</span>
          <span class="tag-badge tag-cyan">Análisis de Malware</span>
          <span class="tag-badge tag-green">Web Hacking</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Proyecto Destacado ── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="section-header">
      <h2 class="section-title font-mono">proyecto_destacado</h2>
    </div>
    <CVManagerCard />
  </section>

  <!-- ── Proyectos Recientes ── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="section-header">
      <h2 class="section-title font-mono">proyectos_recientes</h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {proyectosRecientes.map((p, i) => (
        <div style={`animation-delay: ${i * 0.1}s; opacity: 0`} class="animate-fade-in-up">
          <ProjectCard
            titulo={p.data.titulo}
            descripcion={p.data.descripcion}
            herramientas={p.data.herramientas}
            categoria={p.data.categoria}
            fecha={p.data.fecha}
            estado={p.data.estado}
            slug={p.id}
            github={p.data.github}
            demo={p.data.demo}
          />
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href={`${base}/proyectos`} class="btn-ghost">Ver todos los proyectos →</a>
    </div>
  </section>

  <!-- ── Writeups Recientes ── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="section-header">
      <h2 class="section-title font-mono">writeups_recientes</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {writeupsRecientes.map((w, i) => (
        <div style={`animation-delay: ${i * 0.15}s; opacity: 0`} class="animate-fade-in-up">
          <WriteupCard
            titulo={w.data.titulo}
            descripcion={w.data.descripcion}
            dificultad={w.data.dificultad}
            herramientas={w.data.herramientas}
            categoria={w.data.categoria}
            plataforma={w.data.plataforma}
            fecha={w.data.fecha}
            slug={w.id}
          />
        </div>
      ))}
    </div>

    <div class="text-center mt-8">
      <a href={`${base}/writeups`} class="btn-ghost">Ver todos los writeups →</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero-section {
    min-height: 85vh;
    display: flex; align-items: center;
    position: relative; overflow: hidden;
  }
  .hero-section::before {
    content: '';
    position: absolute; top: -30%; right: -10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(34,211,238,0.06) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-card  { display: none; }
  }

  /* Terminal chip */
  .terminal-chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px; padding: 0.35rem 0.85rem;
    width: fit-content; margin-bottom: 1.5rem;
  }
  .chip-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-neon-cyan);
    box-shadow: 0 0 8px var(--color-neon-cyan);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }
  .chip-label { font-size: 0.78rem; color: var(--color-text-muted); }

  /* Name */
  .hero-name {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .hero-role {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }
  .hero-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 48ch;
    margin-bottom: 0;
  }
  .hero-desc strong { color: var(--color-text-primary); font-weight: 600; }

  .cert-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem; font-weight: 600;
    color: var(--color-neon-orange);
    background: rgba(251,146,60,0.08);
    border: 1px solid rgba(251,146,60,0.3);
    padding: 0.05rem 0.45rem; border-radius: 4px;
  }

  .hero-cta {
    display: flex; flex-wrap: wrap; gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Stat card */
  .stat-card { padding: 1.5rem; }
  .stat-card-header { margin-bottom: 1rem; }
  .stat-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .stat-block {
    display: flex; flex-direction: column;
    align-items: center; text-align: center;
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-subtle);
  }
  .stat-num {
    font-family: var(--font-mono);
    font-size: 1.4rem; font-weight: 700;
  }
  .stat-lbl {
    font-family: var(--font-mono);
    font-size: 0.6rem; text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  /* ── Section title ── */
  .section-title {
    font-size: 0.78rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--color-neon-cyan);
  }

  /* ── About grid ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
  }
  .about-card-wide {
    grid-column: 1 / -1;
  }
  .about-card {
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .about-card-icon {
    color: var(--color-neon-cyan);
    opacity: 0.8;
  }
  .about-card-title {
    font-family: var(--font-sans);
    font-size: 0.95rem; font-weight: 600;
    color: var(--color-text-primary);
  }
  .about-list {
    list-style: none; padding: 0;
    display: flex; flex-direction: column; gap: 0.6rem;
  }
  .about-list li {
    display: flex; align-items: flex-start; gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.87rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .about-list li strong { color: var(--color-text-primary); font-weight: 600; }
  .about-dot {
    width: 6px; height: 6px; border-radius: 50%;
    flex-shrink: 0; margin-top: 0.45rem;
  }
  .about-dot.cyan  { background: var(--color-neon-cyan);  box-shadow: 0 0 6px var(--color-neon-cyan); }
  .about-dot.green { background: var(--color-neon-green); box-shadow: 0 0 6px var(--color-neon-green); }

  .skills-grid {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
</style>
