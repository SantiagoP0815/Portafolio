---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WriteupCard from '../components/WriteupCard.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allProjects = await getCollection('projects');
const allWriteups  = await getCollection('writeups');
const spCount      = allWriteups.filter(w => w.data.startingPoint).length;
const retiredCount = allWriteups.length - spCount;
const retiredLabel = `${retiredCount} máquina${retiredCount === 1 ? '' : 's'} retirada${retiredCount === 1 ? '' : 's'}`;

// Trabajo destacado: lo primero que debe ver un reclutador.
const FEATURED_PROJECTS = ['lapetaca-pos', 'gestion-cvs'];
const FEATURED_WRITEUPS = ['cap', 'vaccine', 'responder'];
const featuredProjects = FEATURED_PROJECTS
  .map(id => allProjects.find(p => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const featuredWriteups = FEATURED_WRITEUPS
  .map(id => allWriteups.find(w => w.id === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));

const skillCategories = [
  { titulo: 'Desarrollo seguro',            icon: 'shield',  skills: ['OWASP Top 10', 'Hardening de cabeceras HTTP', 'Protección CSRF', 'Rate limiting', 'Prevención XSS / SQLi', 'Sanitización de entradas', 'Helmet.js'] },
  { titulo: 'Infraestructura y redes',      icon: 'network', skills: ['TCP/IP', 'DNS / DHCP', 'Subnetting', 'Windows', 'Linux (terminal)', 'VirtualBox / VMware', 'Wireshark / TShark'] },
  { titulo: 'Pentesting y reconocimiento',  icon: 'search',  skills: ['Nmap', 'Gobuster', 'SQLMap', 'John / Hashcat', 'Evil-WinRM', 'Netcat', 'Enumeración SMB / FTP / Redis'] },
  { titulo: 'Desarrollo y automatización',  icon: 'code',    skills: ['Python', 'Bash', 'JavaScript / Node.js', 'Express', 'MySQL', 'Git / GitHub', 'Docker (básico)'] },
] as const;

const metodologia = [
  { fase: 'Reconocimiento', desc: 'Enumeración de puertos, servicios y tecnologías con Nmap, Gobuster y scripts propios.' },
  { fase: 'Foothold',       desc: 'Acceso inicial mediante vulnerabilidades identificadas: SQLi, IDOR, credenciales débiles, archivos expuestos.' },
  { fase: 'Explotación',    desc: 'Explotación de servicios mal configurados y obtención de shells inversas.' },
  { fase: 'Escalada',       desc: 'Elevación a root/Administrator mediante abuso de permisos, binarios SUID y credenciales reutilizadas.' },
  { fase: 'Reporte',        desc: 'Documentación técnica con pasos de reproducción, evidencias y recomendaciones de mitigación.' },
];

const formacion = [
  { icon: 'cap',   titulo: 'Ingeniero de Sistemas e Informática', inst: 'Universidad Pontificia Bolivariana, Seccional Bucaramanga', meta: 'Graduado en mayo 2026', estado: 'Graduado', activo: false },
  { icon: 'award', titulo: 'Bootcamp Ciberseguridad Nivel Intermedio', inst: 'MINTIC · Talento Tech', meta: '159 horas', estado: 'Completado', activo: false },
  { icon: 'award', titulo: 'Fortinet NSE 1 · 2 · 3', inst: 'Fortinet Training Institute', meta: 'Certificación de fundamentos', estado: 'En curso', activo: true },
] as const;

const objetivos = [
  { icon: 'shield', titulo: 'ISC2 Certified in Cybersecurity (CC)', desc: 'Certificación de entrada reconocida por la industria' },
  { icon: 'pulse',  titulo: 'Laboratorio SOC con Wazuh',           desc: 'Detección de ataques, análisis de logs y triage de alertas' },
  { icon: 'eye',    titulo: 'Labs Blue Team',                       desc: 'LetsDefend / Blue Team Labs Online: análisis de incidentes' },
] as const;
---

<Layout
  title="Carlos Santiago Patiño Reyes | Ciberseguridad"
  description="Portafolio de Carlos Santiago Patiño Reyes, Ingeniero de Sistemas especializado en Ciberseguridad, Ethical Hacking y CTF."
>
  <div class="home">

    <!-- ══ Presentación ═══════════════════════════════════════ -->
    <header class="hero animate-fade-in-up">
      <div class="hero-text">
        <p class="whoami-chip font-mono" aria-hidden="true">
          <span class="chip-prompt">$</span> whoami<span class="cursor-blink"></span>
        </p>
        <h1 class="hero-name">
          Carlos Santiago <span class="neon-cyan">Patiño Reyes</span>
        </h1>
        <p class="hero-role">
          Ingeniero de Sistemas. Busco mi primer rol como
          <strong>Analista SOC / Blue Team junior</strong>.
        </p>
        <p class="hero-pitch">
          Practico ataque en HackTheBox para entender cómo defender:
          {allWriteups.length} máquinas documentadas paso a paso y {allProjects.length} herramientas
          propias de seguridad en Python, Bash y Node.js.
        </p>
        <div class="hero-cta">
          <a href="#trabajo" class="btn-primary">
            Ver mi trabajo
            <Icon name="arrow" size={16} />
          </a>
          <a href="mailto:santiago.p.0815@gmail.com" class="btn-ghost">
            <Icon name="mail" size={16} />
            Contactarme
          </a>
          <a href={`${base}/cv`} class="hero-link font-mono">
            <Icon name="document" size={16} />
            Ver CV
          </a>
        </div>
        <ul class="hero-facts font-mono" role="list">
          <li><span class="fact-dot" aria-hidden="true"></span>Disponible</li>
          <li><Icon name="pin" size={15} />Bucaramanga, Colombia · remoto</li>
          <li><Icon name="chat" size={15} />Inglés B2</li>
        </ul>
      </div>
      <img
        class="hero-photo"
        src={`${base}/perfil.jpg`}
        alt="Retrato de Carlos Santiago Patiño Reyes"
        width="200" height="200"
        decoding="async"
        fetchpriority="high"
      />
    </header>

    <!-- ══ Trabajo destacado ══════════════════════════════════ -->
    <section id="trabajo" class="section" aria-labelledby="trabajo-title">
      <div class="section-head">
        <h2 id="trabajo-title" class="section-title"><span class="title-mark" aria-hidden="true">$</span> Trabajo destacado</h2>
      </div>

      <div class="featured-group">
        <div class="group-head">
          <h3 class="group-title">Proyectos</h3>
          <a href={`${base}/projects`} class="see-all font-mono">
            Ver los {allProjects.length} <Icon name="arrow" size={14} />
          </a>
        </div>
        <div class="grid-2">
          {featuredProjects.map(p => (
            <ProjectCard
              titulo={p.data.titulo}
              descripcion={p.data.descripcion}
              herramientas={p.data.herramientas}
              categoria={p.data.categoria}
              fecha={p.data.fecha}
              estado={p.data.estado}
              slug={p.id}
              github={p.data.github}
              headingLevel="h3"
            />
          ))}
        </div>
      </div>

      <div class="featured-group">
        <div class="group-head">
          <h3 class="group-title">Writeups de HackTheBox</h3>
          <a href={`${base}/writeups`} class="see-all font-mono">
            Ver los {allWriteups.length} <Icon name="arrow" size={14} />
          </a>
        </div>
        <div class="grid-3">
          {featuredWriteups.map(w => (
            <WriteupCard
              titulo={w.data.titulo}
              descripcion={w.data.descripcion}
              dificultad={w.data.dificultad}
              herramientas={w.data.herramientas}
              plataforma={w.data.plataforma}
              fecha={w.data.fecha}
              slug={w.id}
              fases={w.data.fases ?? []}
              startingPoint={w.data.startingPoint}
              headingLevel="h3"
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ══ Perfil ═════════════════════════════════════════════ -->
    <div class="body-cols">

      <div class="col-main">
        <section class="section" aria-labelledby="sobre-title">
          <h2 id="sobre-title" class="section-title"><span class="title-mark" aria-hidden="true">$</span> Sobre mí</h2>
          <div class="bio">
            <p>
              Soy Ingeniero de Sistemas e Informática de la <strong>Universidad Pontificia Bolivariana</strong>, Seccional Bucaramanga.
              Busco mi primer rol como <strong>Analista SOC / Blue Team junior</strong> o en <strong>soporte TI</strong> con proyección a seguridad.
            </p>
            <p>
              Entiendo cómo se ataca un sistema porque lo practico: completé el track <strong>Starting Point de HackTheBox</strong>
              ({spCount} máquinas){retiredCount > 0 && <> y {retiredLabel}</>}, documentando cada una con writeups técnicos.
              Y sé cómo defenderlo: mi proyecto de grado es una aplicación web con seguridad integrada desde el diseño
              (CSRF, prevención de XSS/SQLi, rate limiting, cabeceras seguras).
            </p>
            <p>
              Además he construido <strong>{allProjects.length} herramientas</strong> propias en Python y Bash para automatizar
              reconocimiento y detección de vulnerabilidades. Aprendo rápido, documento lo que hago y quiero aportar en un equipo real.
            </p>
          </div>
        </section>

        <section class="section" aria-labelledby="skills-title">
          <h2 id="skills-title" class="section-title"><span class="title-mark" aria-hidden="true">$</span> Habilidades</h2>
          <div class="skills">
            {skillCategories.map(cat => (
              <div class="skill-cat">
                <h3 class="skill-cat-title">
                  <Icon name={cat.icon} size={17} />
                  {cat.titulo}
                </h3>
                <ul class="skill-list" role="list">
                  {cat.skills.map(s => <li class="skill font-mono">{s}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section class="section" aria-labelledby="metodo-title">
          <h2 id="metodo-title" class="section-title"><span class="title-mark" aria-hidden="true">$</span> Cómo abordo una máquina</h2>
          <ol class="metodo" role="list">
            {metodologia.map((m, i) => (
              <li class="metodo-item">
                <span class="metodo-num font-mono" aria-hidden="true">{i + 1}</span>
                <div>
                  <span class="metodo-fase">{m.fase}</span>
                  <span class="metodo-desc">{m.desc}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <aside class="col-side" aria-label="Formación y objetivos">
        <section class="section" aria-labelledby="formacion-title">
          <h2 id="formacion-title" class="section-title"><span class="title-mark" aria-hidden="true">$</span> Formación</h2>
          <ul class="item-list" role="list">
            {formacion.map(f => (
              <li class="item">
                <span class="item-icon"><Icon name={f.icon} size={20} /></span>
                <div class="item-body">
                  <span class="item-name">{f.titulo}</span>
                  <span class="item-inst">{f.inst}</span>
                  <span class="item-meta font-mono">{f.meta}</span>
                </div>
                <span class:list={['tag-badge', f.activo ? 'tag-orange' : 'tag-green']}>{f.estado}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="section" aria-labelledby="objetivos-title">
          <h2 id="objetivos-title" class="section-title"><span class="title-mark" aria-hidden="true">$</span> Próximos objetivos</h2>
          <ul class="item-list" role="list">
            {objetivos.map(obj => (
              <li class="item">
                <span class="item-icon"><Icon name={obj.icon} size={20} /></span>
                <div class="item-body">
                  <span class="item-name">{obj.titulo}</span>
                  <span class="item-meta">{obj.desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="cta-card" aria-labelledby="cta-title">
          <h2 id="cta-title" class="cta-title">¿Tienes una vacante junior en SOC o soporte TI?</h2>
          <p class="cta-text">Estoy abierto a oportunidades, en Bucaramanga o en remoto.</p>
          <a href="mailto:santiago.p.0815@gmail.com" class="btn-primary">
            <Icon name="mail" size={16} />
            Escribirme
          </a>
        </section>
      </aside>

    </div>
  </div>
</Layout>

<style>
  .home {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 2.5rem 5rem;
  }

  /* ── Presentación ────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
    padding-bottom: 3.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .hero-text { display: flex; flex-direction: column; gap: 1.1rem; min-width: 0; }
  .whoami-chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
    width: fit-content;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    background: var(--color-bg-secondary);
    font-size: 0.8rem;
    color: var(--color-text-primary);
  }
  .chip-prompt { color: var(--color-neon-green); }
  .hero-name {
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    font-weight: 750;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }
  .hero-role {
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 38ch;
  }
  .hero-role strong { color: var(--color-text-primary); font-weight: 600; }
  .hero-pitch {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 58ch;
  }
  .hero-cta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .hero-link {
    display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.5rem;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: rgba(163,177,198,0.35);
    text-underline-offset: 4px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-link:hover { color: var(--color-neon-cyan); text-decoration-color: currentColor; }
  }
  .hero-facts {
    list-style: none; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem;
    margin-top: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }
  .hero-facts li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .fact-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-neon-green);
    margin: 0 0.15rem;
  }
  .hero-facts li:first-child { color: var(--color-neon-green); }
  .hero-photo {
    width: 200px; height: 200px;
    border-radius: 1rem;
    object-fit: cover;
    border: 1px solid var(--color-border-subtle);
    box-shadow: 0 18px 40px -18px rgba(0,0,0,0.8);
  }

  /* ── Secciones ───────────────────────────────────────────── */
  .section { margin-bottom: 3rem; }
  .section-title {
    display: flex; align-items: baseline; gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }
  .title-mark {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-neon-cyan);
  }

  /* ── Trabajo destacado ───────────────────────────────────── */
  #trabajo { scroll-margin-top: 5rem; }
  .featured-group + .featured-group { margin-top: 2.25rem; }
  .group-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .group-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .see-all {
    display: inline-flex; align-items: center; gap: 0.35rem;
    min-height: 32px;
    font-size: 0.82rem;
    color: var(--color-neon-cyan);
    text-decoration: none;
  }
  .see-all .icon { transition: transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .see-all:hover .icon { transform: translateX(3px); }
  }
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }

  /* ── Columnas de perfil ──────────────────────────────────── */
  .body-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    margin-top: 1rem;
  }

  .bio { display: flex; flex-direction: column; gap: 1rem; max-width: 68ch; }
  .bio p { font-size: 1rem; line-height: 1.75; color: var(--color-text-secondary); }
  .bio strong { color: var(--color-text-primary); font-weight: 600; }

  .skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2rem; }
  .skill-cat-title {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.95rem; font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.6rem;
  }
  .skill-cat-title .icon { color: var(--color-neon-cyan); }
  .skill-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .skill {
    font-size: 0.78rem;
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.35rem;
    color: var(--color-text-secondary);
  }

  .metodo { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .metodo-item { display: flex; gap: 0.9rem; align-items: flex-start; }
  .metodo-num {
    flex-shrink: 0;
    width: 1.75rem; height: 1.75rem;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(34,211,238,0.4);
    color: var(--color-neon-cyan);
    font-size: 0.8rem; font-weight: 700;
  }
  .metodo-fase { display: block; font-weight: 600; font-size: 0.95rem; color: var(--color-text-primary); }
  .metodo-desc { display: block; font-size: 0.9rem; line-height: 1.6; color: var(--color-text-secondary); }

  .item-list { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .item {
    display: flex; align-items: flex-start; gap: 0.85rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .item:first-child { padding-top: 0; }
  .item-icon { color: var(--color-neon-cyan); margin-top: 0.1rem; }
  .item-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .item-name { font-weight: 600; font-size: 0.95rem; color: var(--color-text-primary); line-height: 1.35; }
  .item-inst { font-size: 0.85rem; color: var(--color-text-secondary); }
  .item-meta { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.5; }
  .item .tag-badge { flex-shrink: 0; margin-top: 0.1rem; }

  .cta-card {
    padding: 1.5rem;
    border: 1px solid rgba(34,211,238,0.35);
    border-radius: 0.85rem;
    background: rgba(34,211,238,0.04);
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem;
  }
  .cta-title { font-size: 1.1rem; font-weight: 650; line-height: 1.35; color: var(--color-text-primary); text-wrap: balance; }
  .cta-text  { font-size: 0.92rem; color: var(--color-text-secondary); margin-bottom: 0.4rem; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .body-cols { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 720px) {
    .home { padding: 2rem 1rem 3.5rem; }
    .hero { grid-template-columns: 1fr; gap: 1.5rem; padding-bottom: 2.5rem; margin-bottom: 2.5rem; }
    .hero-photo { order: -1; width: 88px; height: 88px; border-radius: 50%; }
    .hero-role { font-size: 1.08rem; }
    .grid-2, .grid-3, .skills { grid-template-columns: 1fr; }
    .hero-cta .btn-primary, .hero-cta .btn-ghost { flex: 1 1 auto; }
  }
</style>
