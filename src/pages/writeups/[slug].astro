---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((w: CollectionEntry<'writeups'>) => ({
    params: { slug: w.id },
    props: { writeup: w },
  }));
}

const { writeup } = Astro.props;
const { Content } = await render(writeup);
const { titulo, descripcion, dificultad, herramientas, plataforma, fecha, puntos } = writeup.data;
const base = (import.meta.env.BASE_URL as string).replace(/\/$/, '');

const dateStr = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });

const diffClass: Record<string, string> = {
  easy: 'diff-easy',
  medium: 'diff-medium',
  hard: 'diff-hard',
  insane: 'diff-insane',
};

const platformIcon: Record<string, string> = {
  HackTheBox: '🟢',
  TryHackMe: '🔴',
  CTF: '🏴',
  VulnHub: '🟡',
};
---

<Layout title={`${titulo} | SecPortfolio`} description={descripcion}>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <!-- Breadcrumb -->
    <nav class="breadcrumb mb-8">
      <a href={`${base}/`} class="breadcrumb-link">~/inicio</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`${base}/writeups`} class="breadcrumb-link">writeups</a>
      <span class="breadcrumb-sep">/</span>
      <span style="color: var(--color-text-muted)">{writeup.slug}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-base">{platformIcon[plataforma] ?? '⚡'}</span>
        <span class="font-mono text-sm font-semibold" style="color: var(--color-text-secondary)">{plataforma}</span>
        <span class={`tag-badge ${diffClass[dificultad] || 'diff-easy'}`}>{dificultad}</span>
        {puntos && (
          <span class="font-mono text-xs px-2 py-0.5 rounded" style="background: var(--color-bg-secondary); color: var(--color-neon-purple); border: 1px solid var(--color-border-subtle)">
            {puntos} pts
          </span>
        )}
        <span class="font-mono text-xs" style="color: var(--color-text-muted)">{dateStr}</span>
      </div>

      <h1 class="font-mono text-3xl font-bold mb-4 leading-tight" style="color: var(--color-text-primary)">
        {titulo}
      </h1>
      <p class="font-mono text-sm leading-relaxed" style="color: var(--color-text-secondary); max-width: 60ch">
        {descripcion}
      </p>

      <!-- Tools used -->
      <div class="mt-5">
        <p class="font-mono text-xs mb-2" style="color: var(--color-text-muted)">Herramientas utilizadas:</p>
        <div class="flex flex-wrap gap-2">
          {herramientas.map((tool: string) => (
            <span class="font-mono text-xs px-2.5 py-1 rounded" style="background: var(--color-bg-secondary); color: var(--color-neon-cyan); border: 1px solid var(--color-border-subtle)">
              {tool}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Divider -->
    <div class="h-px mb-10" style="background: linear-gradient(90deg, var(--color-neon-green)44, transparent)"></div>

    <!-- Warning Box -->
    <div class="warning-box mb-8">
      <div class="flex items-start gap-3">
        <span class="text-lg">⚠️</span>
        <div>
          <p class="font-mono text-xs font-bold mb-1" style="color: var(--color-neon-orange)">AVISO LEGAL</p>
          <p class="font-mono text-xs" style="color: var(--color-text-muted)">
            Este writeup es con fines educativos. Las técnicas documentadas fueron realizadas 
            en entornos controlados y autorizados (plataformas CTF).
          </p>
        </div>
      </div>
    </div>

    <!-- Markdown Content -->
    <article class="prose-cyber">
      <Content />
    </article>

    <!-- Back link -->
    <div class="mt-12 pt-8 border-t" style="border-color: var(--color-border-subtle)">
      <a href={`${base}/writeups`} class="btn-ghost">
        ← Volver a writeups
      </a>
    </div>
  </div>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .breadcrumb-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumb-link:hover { color: var(--color-neon-green); }
  .breadcrumb-sep { color: var(--color-border-subtle); }

  .warning-box {
    background: rgba(255, 107, 0, 0.06);
    border: 1px solid rgba(255, 107, 0, 0.25);
    border-radius: 0.5rem;
    padding: 0.875rem 1rem;
  }
</style>
