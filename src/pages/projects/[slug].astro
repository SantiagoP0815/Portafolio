---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({
    params: { slug: p.id },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { titulo, descripcion, herramientas, categoria, fecha, estado, github, demo } = proyecto.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateStr = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });

const categoriaConfig: Record<string, { label: string; accentColor: string; icon: string; cls: string }> = {
  web:        { label: 'Web',        accentColor: '#22d3ee', icon: '◈', cls: 'tag-cyan' },
  red:        { label: 'Red Team',   accentColor: '#4ade80', icon: '⚔', cls: 'tag-green' },
  forense:    { label: 'Forense',    accentColor: '#a78bfa', icon: '🔬', cls: 'tag-purple' },
  malware:    { label: 'Malware',    accentColor: '#f472b6', icon: '☣', cls: 'tag-pink' },
  ctf:        { label: 'CTF',        accentColor: '#fb923c', icon: '⚑', cls: 'tag-orange' },
  desarrollo: { label: 'Desarrollo', accentColor: '#facc15', icon: '⬡', cls: 'tag-yellow' },
};

const estadoMap: Record<string, { label: string; color: string; pulse: boolean }> = {
  completado:    { label: 'LIVE',        color: '#4ade80', pulse: false },
  'en-progreso': { label: 'IN PROGRESS', color: '#fb923c', pulse: true  },
  archivado:     { label: 'ARCHIVED',    color: '#475569', pulse: false },
};

const cat = categoriaConfig[categoria] ?? categoriaConfig.desarrollo;
const est = estadoMap[estado] ?? estadoMap.completado;
---

<Layout title={`${titulo} | Carlos Santiago Patiño Reyes`} description={descripcion}>
  <div class="detail-wrapper" style={`--accent: ${cat.accentColor}`}>

    <!-- ── Breadcrumb ──────────────────────────────────────────── -->
    <nav class="breadcrumb animate-fade-in-up" aria-label="Breadcrumb">
      <a href={`${base}/`} class="bc-link font-mono">~/inicio</a>
      <span class="bc-sep">/</span>
      <a href={`${base}/projects`} class="bc-link font-mono">projects</a>
      <span class="bc-sep">/</span>
      <span class="bc-current font-mono">{proyecto.id}</span>
    </nav>

    <!-- ── Hero Header ────────────────────────────────────────── -->
    <header class="detail-header animate-fade-in-up">
      <!-- Accent strip -->
      <div class="header-strip"></div>

      <div class="header-body">
        <!-- Top badges row -->
        <div class="header-badges">
          <span class="cat-icon">{cat.icon}</span>
          <span class={`tag-badge ${cat.cls}`}>{cat.label}</span>
          <span class="status-pill font-mono">
            <span
              class="status-dot"
              style={`background: ${est.color}; box-shadow: 0 0 6px ${est.color}`}
              class:list={[{ 'pulse-anim': est.pulse }]}
            ></span>
            {est.label}
          </span>
          <span class="date-chip font-mono">
            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
            </svg>
            {dateStr}
          </span>
        </div>

        <!-- Title -->
        <h1 class="detail-title font-mono">
          <span class="title-prompt">$</span>
          {titulo}
        </h1>

        <!-- Description -->
        <p class="detail-desc">{descripcion}</p>

        <!-- CTA buttons -->
        <div class="header-actions">
          {github && (
            <a href={github} target="_blank" rel="noopener noreferrer" class="btn-primary">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
              </svg>
              Ver en GitHub
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
              </svg>
              Demo en vivo
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- ── Two-column layout ───────────────────────────────────── -->
    <div class="content-layout">

      <!-- ── Sidebar ────────────────────────────────────────── -->
      <aside class="sidebar animate-fade-in-up">

        <!-- Tech Stack -->
        <div class="sidebar-card">
          <div class="sidebar-card-header font-mono">
            <span class="sidebar-card-icon">›</span>
            tech_stack
          </div>
          <div class="stack-list">
            {herramientas.map(tool => (
              <div class="stack-item font-mono">
                <span class="stack-bullet" style={`color: ${cat.accentColor}`}>▸</span>
                {tool}
              </div>
            ))}
          </div>
        </div>

        <!-- Metadata -->
        <div class="sidebar-card">
          <div class="sidebar-card-header font-mono">
            <span class="sidebar-card-icon">›</span>
            metadata
          </div>
          <div class="meta-list">
            <div class="meta-item">
              <span class="meta-key font-mono">categoría</span>
              <span class={`tag-badge ${cat.cls}`}>{cat.label}</span>
            </div>
            <div class="meta-item">
              <span class="meta-key font-mono">estado</span>
              <span class="meta-val font-mono" style={`color: ${est.color}`}>{est.label}</span>
            </div>
            <div class="meta-item">
              <span class="meta-key font-mono">fecha</span>
              <span class="meta-val font-mono">{dateStr}</span>
            </div>
            <div class="meta-item">
              <span class="meta-key font-mono">tools</span>
              <span class="meta-val font-mono">{herramientas.length}</span>
            </div>
          </div>
        </div>

        <!-- Back button -->
        <a href={`${base}/projects`} class="btn-ghost back-btn">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
          </svg>
          Volver a proyectos
        </a>
      </aside>

      <!-- ── Main content ───────────────────────────────────── -->
      <main class="main-content animate-fade-in-up">
        <!-- Content chrome bar -->
        <div class="content-chrome">
          <div class="chrome-dots">
            <span class="chrome-dot" style="background:#ff5f57"></span>
            <span class="chrome-dot" style="background:#ffbd2e"></span>
            <span class="chrome-dot" style="background:#28ca41"></span>
          </div>
          <span class="chrome-label font-mono">{proyecto.id}.md</span>
        </div>

        <article class="prose-cyber content-body">
          <Content />
        </article>
      </main>
    </div>

  </div>
</Layout>

<style>
  /* ── Wrapper ─────────────────────────────────────────────────── */
  .detail-wrapper {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ── Breadcrumb ──────────────────────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
  }
  .bc-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .bc-link:hover { color: var(--color-neon-cyan); }
  .bc-sep { color: var(--color-border-subtle); }
  .bc-current { color: var(--accent); }

  /* ── Hero Header ─────────────────────────────────────────────── */
  .detail-header {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.875rem;
    overflow: hidden;
  }
  .header-strip {
    height: 3px;
    background: linear-gradient(90deg, var(--accent), transparent 60%);
  }
  .header-body {
    padding: 2rem 2.25rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .header-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cat-icon {
    font-size: 1rem;
    color: var(--accent);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .pulse-anim { animation: statusPulse 2s ease-in-out infinite; }
  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }
  .date-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-left: auto;
  }

  .detail-title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .title-prompt {
    color: var(--color-neon-green);
    font-size: 1.1em;
    flex-shrink: 0;
    margin-top: 0.05em;
  }

  .detail-desc {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    max-width: 68ch;
    padding-left: 1.7rem;
    border-left: 2px solid rgba(34,211,238,0.2);
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-left: 1.7rem;
  }

  /* ── Two-column layout ───────────────────────────────────────── */
  .content-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  /* ── Sidebar ─────────────────────────────────────────────────── */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 900px) {
    .content-layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
  }
  .sidebar-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .sidebar-card-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .sidebar-card-icon { color: var(--accent); font-size: 0.9rem; }

  /* Stack list */
  .stack-list {
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .stack-item {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s;
  }
  .stack-item:hover { color: var(--color-text-primary); }
  .stack-bullet { font-size: 0.7rem; flex-shrink: 0; }

  /* Meta list */
  .meta-list {
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .meta-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .meta-key {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .meta-val {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    text-align: right;
  }

  .back-btn {
    width: 100%;
    justify-content: center;
    font-size: 0.78rem;
  }

  /* ── Main content area ───────────────────────────────────────── */
  .main-content {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.875rem;
    overflow: hidden;
  }
  .content-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .chrome-dots { display: flex; gap: 0.35rem; }
  .chrome-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .chrome-label {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-left: 0.4rem;
  }
  .content-body {
    padding: 2rem 2.25rem 2.5rem;
  }
</style>
