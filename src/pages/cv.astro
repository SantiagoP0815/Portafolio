---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allWriteups = await getCollection('writeups');
const allProjects = await getCollection('projects');
const sortedWriteups = allWriteups.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const machineNames = sortedWriteups.map(w => w.data.titulo.replace(/\.md$/, '')).join(', ');
const htbCount = allWriteups.filter(w => w.data.categoria === 'htb').length;
