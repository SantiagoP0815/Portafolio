<script>
  const btnEs = document.getElementById('lang-es')!;
  const btnEn = document.getElementById('lang-en')!;
  const btnPrint = document.getElementById('print-btn')!;
  const cvEs  = document.getElementById('cv-es')!;
  const cvEn  = document.getElementById('cv-en')!;

  let currentLang: 'es' | 'en' = 'es';

  function showLang(lang: 'es' | 'en') {
    currentLang = lang;
    const showEs = lang === 'es';
    cvEs.style.display = showEs ? '' : 'none';
    cvEn.style.display = showEs ? 'none' : '';
    btnEs.classList.toggle('lang-btn-active', showEs);
    btnEn.classList.toggle('lang-btn-active', !showEs);
  }

  btnEs.addEventListener('click', () => showLang('es'));
  btnEn.addEventListener('click', () => showLang('en'));

  function beforePrint() {
    if (currentLang === 'es') {
      cvEn.style.display = 'none';
      cvEs.style.display = '';
    } else {
      cvEs.style.display = 'none';
      cvEn.style.display = '';
    }
  }

  function afterPrint() {
    showLang(currentLang);
  }

  window.addEventListener('beforeprint', beforePrint);
  window.addEventListener('afterprint', afterPrint);

  btnPrint.addEventListener('click', () => window.print());
</script>

<style>
