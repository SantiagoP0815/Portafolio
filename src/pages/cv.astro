---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allWriteups = await getCollection('writeups');
const allProjects = await getCollection('projects');
const sortedWriteups = allWriteups.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const spMachines      = sortedWriteups.filter(w => w.data.startingPoint).map(w => w.data.titulo);
const retiredMachines = sortedWriteups.filter(w => !w.data.startingPoint).map(w => w.data.titulo);
const spCount      = spMachines.length;
const retiredCount = retiredMachines.length;
const retiredEs = `${retiredCount} ${retiredCount === 1 ? 'máquina retirada' : 'máquinas retiradas'}`;
const retiredEn = `${retiredCount} ${retiredCount === 1 ? 'retired machine' : 'retired machines'}`;
