---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map(p => ({
    params: { slug: p.id },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { titulo, descripcion, herramientas, categoria, fecha, estado, github, demo } = proyecto.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateStr = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });

const estadoMap: Record<string, { label: string; color: string }> = {
  completado: { label: '● completado', color: 'var(--color-neon-green)' },
  'en-progreso': { label: '◐ en progreso', color: 'var(--color-neon-orange)' },
  archivado: { label: '○ archivado', color: 'var(--color-text-muted)' },
};
const estadoInfo = estadoMap[estado] ?? estadoMap.completado;
---

<Layout title={`${titulo} | SecPortfolio`} description={descripcion}>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <!-- Breadcrumb -->
    <nav class="breadcrumb mb-8">
      <a href={`${base}/`} class="breadcrumb-link">~/inicio</a>
      <span class="breadcrumb-sep">/</span>
      <a href={`${base}/proyectos`} class="breadcrumb-link">proyectos</a>
      <span class="breadcrumb-sep">/</span>
      <span style="color: var(--color-text-muted)">{proyecto.slug}</span>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="tag-badge tag-cyan">{categoria}</span>
        <span class="font-mono text-xs" style={`color: ${estadoInfo.color}`}>{estadoInfo.label}</span>
        <span class="font-mono text-xs" style="color: var(--color-text-muted)">{dateStr}</span>
      </div>

      <h1 class="font-mono text-3xl font-bold mb-4" style="color: var(--color-text-primary)">
        {titulo}
      </h1>
      <p class="font-mono text-sm leading-relaxed" style="color: var(--color-text-secondary); max-width: 60ch">
        {descripcion}
      </p>

      <!-- Tools -->
      <div class="flex flex-wrap gap-2 mt-5">
        {herramientas.map(tool => (
          <span class="font-mono text-xs px-2.5 py-1 rounded" style="background: var(--color-bg-secondary); color: var(--color-neon-green); border: 1px solid var(--color-border-subtle)">
            {tool}
          </span>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap gap-3 mt-6">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
            GitHub
          </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="btn-ghost">
            Demo →
          </a>
        )}
      </div>
    </header>

    <!-- Divider -->
    <div class="h-px mb-10" style="background: linear-gradient(90deg, var(--color-neon-cyan)44, transparent)"></div>

    <!-- Markdown Content -->
    <article class="prose-cyber">
      <Content />
    </article>

    <!-- Back link -->
    <div class="mt-12 pt-8 border-t" style="border-color: var(--color-border-subtle)">
      <a href={`${base}/proyectos`} class="btn-ghost">
        ← Volver a proyectos
      </a>
    </div>
  </div>
</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .breadcrumb-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumb-link:hover { color: var(--color-neon-cyan); }
  .breadcrumb-sep { color: var(--color-border-subtle); }
</style>
