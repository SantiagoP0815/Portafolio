---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CVManagerCard from '../../components/CVManagerCard.astro';

const allProyectos = await getCollection('proyectos');
const proyectos = allProyectos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

const categorias = ['todos', ...new Set(proyectos.map(p => p.data.categoria))];
const proyectosNormales = proyectos.filter(p => !p.data.destacado);
---

<Layout 
  title="Proyectos | SecPortfolio"
  description="Proyectos de ciberseguridad: herramientas de pentesting, honeypots, scanners de vulnerabilidades y desarrollo seguro."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Page Header -->
    <div class="page-header mb-12">
      <div class="font-mono text-xs mb-3" style="color: var(--color-text-muted)">
        <span style="color: var(--color-neon-cyan)">~/proyectos</span> $ ls -la
      </div>
      <h1 class="font-mono text-3xl font-bold" style="color: var(--color-text-primary)">
        Proyectos<span class="neon-cyan">.</span>
      </h1>
      <p class="font-mono text-sm mt-3" style="color: var(--color-text-secondary); max-width: 60ch">
        Herramientas, scripts y aplicaciones desarrolladas durante mi camino en ciberseguridad.
        Cada proyecto incluye documentación técnica y el razonamiento de seguridad detrás.
      </p>
    </div>

    <!-- Featured project -->
    <div class="mb-14">
      <div class="section-header">
        <h2 class="font-mono text-sm font-bold uppercase tracking-widest" style="color: var(--color-neon-cyan)">
          // destacado
        </h2>
      </div>
      <CVManagerCard />
    </div>

    <!-- Filter Tabs -->
    <div class="section-header mb-6">
      <h2 class="font-mono text-sm font-bold uppercase tracking-widest" style="color: var(--color-neon-cyan)">
        // todos los proyectos
      </h2>
    </div>

    <div class="filter-bar mb-8" id="filter-bar" role="group" aria-label="Filtrar por categoría">
      {categorias.map(cat => (
        <button
          class={`filter-btn font-mono text-xs ${cat === 'todos' ? 'filter-btn-active' : ''}`}
          data-filter={cat}
          id={`filter-${cat}`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5" id="projects-grid">
      {proyectosNormales.map((p, i) => (
        <div
          class="project-item animate-fade-in-up"
          data-categoria={p.data.categoria}
          style={`animation-delay: ${i * 0.1}s; opacity: 0`}
        >
          <ProjectCard
            titulo={p.data.titulo}
            descripcion={p.data.descripcion}
            herramientas={p.data.herramientas}
            categoria={p.data.categoria}
            fecha={p.data.fecha}
            estado={p.data.estado}
            slug={p.id}
            github={p.data.github}
            demo={p.data.demo}
          />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-16">
      <div class="font-mono text-4xl mb-4">🔍</div>
      <p class="font-mono text-sm" style="color: var(--color-text-muted)">
        No hay proyectos en esta categoría todavía.
      </p>
    </div>
  </div>
</Layout>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter-btn {
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .filter-btn:hover {
    border-color: var(--color-neon-cyan)66;
    color: var(--color-neon-cyan);
  }
  .filter-btn-active {
    border-color: var(--color-neon-cyan) !important;
    color: var(--color-neon-cyan) !important;
    background: rgba(0, 245, 255, 0.08) !important;
    box-shadow: 0 0 10px rgba(0, 245, 255, 0.15);
  }
</style>

<script>
  const filterBar = document.getElementById('filter-bar');
  const items = document.querySelectorAll<HTMLElement>('.project-item');
  const emptyState = document.getElementById('empty-state');

  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;

    const filter = btn.dataset.filter ?? 'todos';

    // Update active button
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('filter-btn-active'));
    btn.classList.add('filter-btn-active');

    // Filter items
    let visible = 0;
    items.forEach(item => {
      const match = filter === 'todos' || item.dataset.categoria === filter;
      item.style.display = match ? 'block' : 'none';
      if (match) visible++;
    });

    // Empty state
    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }
  });
</script>
