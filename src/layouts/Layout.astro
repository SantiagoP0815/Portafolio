---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Carlos Santiago Patiño Reyes | Ciberseguridad',
  description = 'Portafolio de Carlos Santiago Patiño Reyes — Ciberseguridad, Ethical Hacking, CTF Writeups y proyectos de seguridad.'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Open Graph / canonical requieren URLs absolutas
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(`${base}/og-image.png`, Astro.site).href;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#080d12" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content="Carlos Santiago Patiño Reyes — Ciberseguridad" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <title>{title}</title>
</head>
<body class="scanlines app-shell">
  <a href="#main" class="skip-link font-mono">Saltar al contenido</a>
  <canvas id="particle-canvas" aria-hidden="true"></canvas>
  <Sidebar />
  <div class="page-content">
    <main id="main" class="grid-bg" tabindex="-1">
      <slot />
    </main>
  </div>
</body>
</html>

<script>
(function () {
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  const COLOR = '34, 211, 238';
  // Las líneas se agrupan en pocos niveles de opacidad para trazarlas en lote
  // (un stroke() por nivel en vez de uno por línea).
  const ALPHA_LEVELS = 4;

  let w = 0, h = 0;
  let count = 0;
  let linkDist = 0;
  let particles: { x: number; y: number; vx: number; vy: number; r: number; a: number }[] = [];
  let rafId = 0;

  function configure() {
    const mobile = window.innerWidth < 768;
    count = mobile ? 45 : 110;
    linkDist = mobile ? 100 : 150;
  }

  function resize() {
    const newW = window.innerWidth;
    // En pantallas táctiles se usa la altura completa de la pantalla para cubrir
    // de entrada el área que queda libre cuando se oculta la barra de direcciones.
    const newH = isTouch ? Math.max(window.innerHeight, window.screen.height) : window.innerHeight;
    const widthChanged = newW !== w;

    // En móvil, la barra de direcciones aparece/desaparece al hacer scroll y
    // cambia solo la altura. El canvas se dimensiona a la mayor altura vista,
    // así que esos cambios no deben redimensionar ni mover nada.
    if (!widthChanged && newH <= h) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = newW;
    h = widthChanged ? newH : Math.max(h, newH);
    canvas!.width = Math.round(w * dpr);
    canvas!.height = Math.round(h * dpr);
    canvas!.style.width = `${w}px`;
    canvas!.style.height = `${h}px`;
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

    // Solo se regeneran las partículas cuando cambia el ancho
    // (rotación de pantalla, ventana de escritorio redimensionada).
    if (widthChanged || particles.length === 0) {
      configure();
      initParticles();
    }
    if (reducedMotion.matches) draw();
  }

  function initParticles() {
    particles = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      r: Math.random() * 1.6 + 0.8,
      a: Math.random() * 0.4 + 0.2,
    }));
  }

  function update() {
    for (const p of particles) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0 || p.x > w) { p.vx *= -1; p.x = Math.max(0, Math.min(w, p.x)); }
      if (p.y < 0 || p.y > h) { p.vy *= -1; p.y = Math.max(0, Math.min(h, p.y)); }
    }
  }

  function draw() {
    ctx!.clearRect(0, 0, w, h);

    // Conexiones, agrupadas por nivel de opacidad
    const maxD2 = linkDist * linkDist;
    const buckets: number[][] = Array.from({ length: ALPHA_LEVELS }, () => []);
    for (let i = 0; i < particles.length; i++) {
      const a = particles[i];
      for (let j = i + 1; j < particles.length; j++) {
        const b = particles[j];
        const dx = a.x - b.x, dy = a.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < maxD2) {
          const level = Math.min(ALPHA_LEVELS - 1, Math.floor((1 - Math.sqrt(d2) / linkDist) * ALPHA_LEVELS));
          buckets[level].push(a.x, a.y, b.x, b.y);
        }
      }
    }
    ctx!.lineWidth = 0.6;
    buckets.forEach((segs, level) => {
      if (!segs.length) return;
      ctx!.strokeStyle = `rgba(${COLOR}, ${(((level + 1) / ALPHA_LEVELS) * 0.15).toFixed(3)})`;
      ctx!.beginPath();
      for (let k = 0; k < segs.length; k += 4) {
        ctx!.moveTo(segs[k], segs[k + 1]);
        ctx!.lineTo(segs[k + 2], segs[k + 3]);
      }
      ctx!.stroke();
    });

    // Partículas
    for (const p of particles) {
      ctx!.beginPath();
      ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${COLOR}, ${p.a})`;
      ctx!.fill();
    }
  }

  function loop() {
    update();
    draw();
    rafId = requestAnimationFrame(loop);
  }

  function start() {
    cancelAnimationFrame(rafId);
    if (reducedMotion.matches) draw();   // fondo estático, sin animación
    else loop();
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resize, 150);
  });
  reducedMotion.addEventListener('change', start);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) cancelAnimationFrame(rafId);
    else start();
  });

  resize();
  start();
})();
</script>

<style>
  #particle-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .page-content { position: relative; z-index: 1; }
  main:focus { outline: none; }

  .skip-link {
    position: fixed;
    top: 0.75rem; left: 0.75rem;
    z-index: 10000;
    padding: 0.55rem 1rem;
    border-radius: 0.5rem;
    background: var(--color-neon-cyan);
    color: var(--color-bg-primary);
    font-size: 0.8rem; font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }
  .skip-link:focus { transform: translateY(0); }
</style>
