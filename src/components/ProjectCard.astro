---
// ProjectCard.astro — Tarjeta de proyecto estándar
interface Props {
  titulo: string;
  descripcion: string;
  herramientas: string[];
  categoria: string;
  fecha: Date;
  estado: string;
  slug: string;
  github?: string;
  demo?: string;
}

const { titulo, descripcion, herramientas, categoria, fecha, estado, slug, github, demo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categoriaColors: Record<string, string> = {
  web: 'tag-cyan',
  red: 'tag-green',
  forense: 'tag-purple',
  malware: 'tag-pink',
  ctf: 'tag-orange',
  desarrollo: 'tag-cyan',
};

const estadoMap: Record<string, { label: string; color: string }> = {
  completado: { label: '● completado', color: 'var(--color-neon-green)' },
  'en-progreso': { label: '◐ en progreso', color: 'var(--color-neon-orange)' },
  archivado: { label: '○ archivado', color: 'var(--color-text-muted)' },
};

const estadoInfo = estadoMap[estado] ?? estadoMap.completado;
const dateStr = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'short' });
---

<article class="card-cyber p-6 flex flex-col gap-4 animate-fade-in-up">
  <!-- Top bar -->
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <!-- Category icon -->
      <div class="cat-icon">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 10c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.249-8.25-3.286z"/>
        </svg>
      </div>
      <span class={`tag-badge ${categoriaColors[categoria] || 'tag-cyan'}`}>
        {categoria}
      </span>
    </div>
    <span class="font-mono text-xs" style={`color: ${estadoInfo.color}`}>
      {estadoInfo.label}
    </span>
  </div>

  <!-- Title & Description -->
  <div>
    <h3 class="font-mono font-bold text-lg mb-2" style="color: var(--color-text-primary)">
      {titulo}
    </h3>
    <p class="font-mono text-sm leading-relaxed" style="color: var(--color-text-secondary)">
      {descripcion}
    </p>
  </div>

  <!-- Tools -->
  <div class="flex flex-wrap gap-1.5">
    {herramientas.slice(0, 5).map(tool => (
      <span class="font-mono text-xs px-2 py-0.5 rounded" style="background: var(--color-bg-secondary); color: var(--color-neon-green); border: 1px solid var(--color-border-subtle)">
        {tool}
      </span>
    ))}
    {herramientas.length > 5 && (
      <span class="font-mono text-xs px-2 py-0.5 rounded" style="color: var(--color-text-muted)">
        +{herramientas.length - 5} más
      </span>
    )}
  </div>

  <!-- Footer Actions -->
  <div class="flex items-center justify-between pt-2 border-t" style="border-color: var(--color-border-subtle)">
    <span class="font-mono text-xs" style="color: var(--color-text-muted)">{dateStr}</span>
    <div class="flex items-center gap-2">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn-ghost text-xs py-1 px-2.5" aria-label="GitHub">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
          Código
        </a>
      )}
      <a href={`${base}/proyectos/${slug}`} class="btn-primary text-xs py-1 px-3">
        Ver más →
      </a>
    </div>
  </div>
</article>

<style>
  .cat-icon {
    color: var(--color-neon-cyan);
    opacity: 0.7;
  }
</style>
