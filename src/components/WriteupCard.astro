---
// WriteupCard.astro
interface Props {
  titulo: string;
  descripcion: string;
  dificultad: string;
  herramientas: string[];
  categoria: string;
  plataforma: string;
  fecha: Date;
  slug: string;
}

const { titulo, descripcion, dificultad, herramientas, categoria, plataforma, fecha, slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateStr = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' });

const diffClass: Record<string, string> = {
  easy: 'diff-easy',
  medium: 'diff-medium',
  hard: 'diff-hard',
  insane: 'diff-insane',
};

const platformIcon: Record<string, string> = {
  HackTheBox: '🟢',
  TryHackMe: '🔴',
  CTF: '🏴',
  VulnHub: '🟡',
};
---

<article class="card-cyber p-5 flex flex-col gap-3 animate-fade-in-up">
  <!-- Header -->
  <div class="flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="text-sm">{platformIcon[plataforma] ?? '⚡'}</span>
      <span class="font-mono text-xs" style="color: var(--color-text-muted)">{plataforma}</span>
      <span style="color: var(--color-text-muted)">·</span>
      <span class={`tag-badge ${diffClass[dificultad] || 'diff-easy'}`}>
        {dificultad}
      </span>
    </div>
    <span class="font-mono text-xs" style="color: var(--color-text-muted)">{dateStr}</span>
  </div>

  <!-- Title -->
  <h3 class="font-mono font-bold text-base" style="color: var(--color-text-primary); line-height: 1.3">
    {titulo}
  </h3>

  <!-- Description -->
  <p class="font-mono text-sm leading-relaxed" style="color: var(--color-text-secondary)">
    {descripcion}
  </p>

  <!-- Tools -->
  <div class="flex flex-wrap gap-1.5">
    {herramientas.slice(0, 4).map(tool => (
      <span class="font-mono text-xs px-2 py-0.5 rounded" style="background: var(--color-bg-secondary); color: var(--color-neon-cyan); border: 1px solid var(--color-border-subtle)">
        {tool}
      </span>
    ))}
  </div>

  <!-- Action -->
  <div class="pt-1">
    <a href={`${base}/writeups/${slug}`} class="btn-ghost text-xs w-full justify-center">
      Leer writeup →
    </a>
  </div>
</article>
