---
// WriteupCard.astro — Terminal-style card with attack chain visualization
interface Props {
  titulo: string;
  descripcion: string;
  dificultad: string;
  herramientas: string[];
  categoria?: string;
  plataforma: string;
  fecha: Date;
  slug: string;
  fases?: string[];
  /** Máquina del track Starting Point (si no, es una máquina retirada) */
  startingPoint?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { titulo, descripcion, dificultad, herramientas, plataforma, fecha, slug, fases = [], startingPoint = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const track = startingPoint ? 'Starting Point' : 'Retirada';
// Abreviatura para la barra de ventana (el nombre completo va debajo, junto al icono)
const platShort: Record<string, string> = { HackTheBox: 'HTB', TryHackMe: 'THM' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateStr = fecha.toLocaleDateString('es-CO', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' });

const diffConfig: Record<string, { cls: string; label: string; dot: string }> = {
  easy:   { cls: 'diff-easy',   label: 'EASY',   dot: '#4ade80' },
  medium: { cls: 'diff-medium', label: 'MEDIUM', dot: '#fb923c' },
  hard:   { cls: 'diff-hard',   label: 'HARD',   dot: '#f472b6' },
  insane: { cls: 'diff-insane', label: 'INSANE', dot: '#a78bfa' },
};
const diff = diffConfig[dificultad] ?? diffConfig.easy;

const platformMeta: Record<string, { icon: string; color: string }> = {
  HackTheBox: { icon: '⬡', color: '#9fef00' },
  TryHackMe:  { icon: '◈', color: '#ff3f3f' },
  CTF:        { icon: '⚑', color: '#22d3ee' },
  VulnHub:    { icon: '◉', color: '#fb923c' },
};
const plat = platformMeta[plataforma] ?? { icon: '⚡', color: '#22d3ee' };

const phases = fases.length ? fases : ['Explotación'];
const MAX_TOOLS_DISPLAY = 5;
---

<article class="wcard" style={`--accent: ${diff.dot}`}>
  <!-- Terminal window chrome -->
  <div class="wcard-chrome">
    <span class="chrome-dot" style="background:#ff5f57" aria-hidden="true"></span>
    <span class="chrome-dot" style="background:#ffbd2e" aria-hidden="true"></span>
    <span class="chrome-dot" style="background:#28ca41" aria-hidden="true"></span>
    <span class:list={['chrome-title font-mono', { 'chrome-retired': !startingPoint }]}>{platShort[plataforma] ?? plataforma} · {track}</span>
  </div>

  <div class="wcard-body">
    <!-- Header row -->
    <div class="wcard-header">
      <div class="wcard-platform">
        <span class="plat-icon" style={`color: ${plat.color}`} aria-hidden="true">{plat.icon}</span>
        <span class="plat-name font-mono">{plataforma}</span>
      </div>
      <div class="wcard-badges">
        <span class={`tag-badge ${diff.cls}`}>
          <span class="diff-dot" style={`background:${diff.dot}; box-shadow: 0 0 6px ${diff.dot}`} aria-hidden="true"></span>
          {diff.label}
        </span>
        <time class="date-badge font-mono" datetime={fecha.toISOString()}>{dateStr}</time>
      </div>
    </div>

    <!-- Title — styled as a shell prompt -->
    <div class="wcard-prompt">
      <span class="prompt-symbol font-mono" aria-hidden="true">$</span>
      <Heading class="wcard-title font-mono">{titulo}</Heading>
    </div>

    <!-- Description -->
    <p class="wcard-desc">{descripcion}</p>

    <!-- Attack Chain Pills -->
    <div class="attack-chain">
      {phases.map((phase, i) => (
        <div class="chain-step">
          <span class="chain-label font-mono">{phase}</span>
          {i < phases.length - 1 && <span class="chain-arrow" aria-hidden="true">→</span>}
        </div>
      ))}
    </div>

    <!-- Tools used -->
    <div class="wcard-tools">
      {herramientas.slice(0, MAX_TOOLS_DISPLAY).map(tool => (
        <span class="tool-pill font-mono">
          <span class="tool-hash" aria-hidden="true">#</span>{tool}
        </span>
      ))}
      {herramientas.length > MAX_TOOLS_DISPLAY && (
        <span class="tool-more font-mono">+{herramientas.length - MAX_TOOLS_DISPLAY}</span>
      )}
    </div>

    <!-- CTA -->
    <a href={`${base}/writeups/${slug}`} class="wcard-cta btn-primary" aria-label={`Leer writeup de ${titulo}`}>
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
      </svg>
      cat writeup.md
    </a>
  </div>
</article>

<style>
  /* ── Card shell ─────────────────────────────────────────────── */
  .wcard {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
    position: relative;
  }
  .wcard::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  /* Elevación solo con ratón: en pantallas táctiles el hover se queda "pegado" */
  @media (hover: hover) and (pointer: fine) {
    .wcard:hover {
      border-color: var(--accent);
      box-shadow: 0 8px 40px color-mix(in srgb, var(--accent) 12%, transparent);
      transform: translateY(-3px);
    }
    .wcard:hover::before { opacity: 0.6; }
    .wcard:hover .wcard-cta {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--color-bg-primary);
      box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 35%, transparent);
    }
  }
  .wcard:active { transform: translateY(0) scale(0.99); }
  .wcard:has(.wcard-cta:focus-visible) { border-color: var(--accent); }
  /* Con teclado el botón se rellena igual que con el ratón */
  .wcard-cta:focus-visible {
    background: var(--accent);
    color: var(--color-bg-primary);
  }

  /* ── Chrome bar ─────────────────────────────────────────────── */
  .wcard-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: 0.5rem 0.9rem;
  }
  .chrome-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .chrome-retired { color: var(--color-neon-purple); }
  .chrome-title {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-left: 0.5rem;
  }

  /* ── Body ───────────────────────────────────────────────────── */
  .wcard-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .wcard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .wcard-platform {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .plat-icon { font-size: 1rem; }
  .plat-name {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
  .wcard-badges { display: flex; align-items: center; gap: 0.5rem; }
  .date-badge {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .diff-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Prompt title ───────────────────────────────────────────── */
  .wcard-prompt {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .prompt-symbol {
    color: var(--color-neon-green);
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
  }
  .wcard-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.35;
  }

  /* ── Description ────────────────────────────────────────────── */
  .wcard-desc {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-border-subtle);
  }

  /* ── Attack chain ───────────────────────────────────────────── */
  .attack-chain {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    padding: 0.45rem 0.65rem;
    background: rgba(34,211,238,0.03);
    border: 1px solid rgba(34,211,238,0.1);
    border-radius: 0.4rem;
  }
  .chain-step {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .chain-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neon-cyan);
  }
  .chain-arrow {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* ── Tools ──────────────────────────────────────────────────── */
  .wcard-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tool-pill {
    font-size: 0.75rem;
    padding: 0.18rem 0.55rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.35rem;
    color: var(--color-neon-green);
    white-space: nowrap;
  }
  .tool-hash {
    color: var(--color-text-muted);
    margin-right: 0.15rem;
  }
  .tool-more {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 0.18rem 0.4rem;
  }

  /* ── CTA ────────────────────────────────────────────────────── */
  .wcard-cta {
    margin-top: auto;
    width: 100%;
    justify-content: center;
    font-size: 0.8rem;
    border-color: var(--accent);
    color: var(--accent);
  }
  /* Toda la tarjeta lleva al writeup: el enlace se estira sobre ella */
  .wcard-cta::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  /* Sin escala al pulsar: encogería el área clicable bajo el cursor y el clic se perdería */
  .wcard-cta:active { transform: none; }
</style>