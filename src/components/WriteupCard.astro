---
// WriteupCard.astro — Terminal-style card with attack chain visualization
interface Props {
  titulo: string;
  descripcion: string;
  dificultad: string;
  herramientas: string[];
  categoria: string;
  plataforma: string;
  fecha: Date;
  slug: string;
}

const { titulo, descripcion, dificultad, herramientas, categoria, plataforma, fecha, slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateStr = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' });

const diffConfig: Record<string, { cls: string; label: string; dot: string }> = {
  easy:   { cls: 'diff-easy',   label: 'EASY',   dot: '#4ade80' },
  medium: { cls: 'diff-medium', label: 'MEDIUM', dot: '#fb923c' },
  hard:   { cls: 'diff-hard',   label: 'HARD',   dot: '#f472b6' },
  insane: { cls: 'diff-insane', label: 'INSANE', dot: '#a78bfa' },
};
const diff = diffConfig[dificultad] ?? diffConfig.easy;

const platformMeta: Record<string, { icon: string; color: string }> = {
  HackTheBox: { icon: '⬡', color: '#9fef00' },
  TryHackMe:  { icon: '◈', color: '#ff3f3f' },
  CTF:        { icon: '⚑', color: '#22d3ee' },
  VulnHub:    { icon: '◉', color: '#fb923c' },
};
const plat = platformMeta[plataforma] ?? { icon: '⚡', color: '#22d3ee' };

const recon    = ['nmap','rustscan','gobuster','ffuf','feroxbuster','enum4linux','ldapsearch','whatweb','wfuzz','dirsearch','masscan','dig','whois','crackmapexec','bloodhound','dnsx','httpx'];
const foothold = ['sqlmap','metasploit','burpsuite','chisel','netcat','hydra','evil-winrm','responder','impacket','john','hashcat','exploit','msfvenom'];
const privesc  = ['linpeas','winpeas','pspy','mimikatz','sudo','gtfobins','ltrace','strace'];

const tl = herramientas.map(t => t.toLowerCase());
const detected: string[] = [];
if (tl.some(t => recon.some(r => t.includes(r))))    detected.push('Recon');
if (tl.some(t => foothold.some(f => t.includes(f)))) detected.push('Foothold');
if (tl.some(t => privesc.some(p => t.includes(p))))  detected.push('PrivEsc');
const phases = detected.length ? detected : ['Exploitation'];
---

<article class="wcard">
  <!-- Terminal window chrome -->
  <div class="wcard-chrome">
    <span class="chrome-dot" style="background:#ff5f57"></span>
    <span class="chrome-dot" style="background:#ffbd2e"></span>
    <span class="chrome-dot" style="background:#28ca41"></span>
    <span class="chrome-title font-mono">{plataforma} · {categoria}</span>
  </div>

  <div class="wcard-body">
    <!-- Header row -->
    <div class="wcard-header">
      <div class="wcard-platform">
        <span class="plat-icon" style={`color: ${plat.color}`}>{plat.icon}</span>
        <span class="plat-name font-mono">{plataforma}</span>
      </div>
      <div class="wcard-badges">
        <span class={`tag-badge ${diff.cls}`}>
          <span class="diff-dot" style={`background:${diff.dot}; box-shadow: 0 0 6px ${diff.dot}`}></span>
          {diff.label}
        </span>
        <span class="date-badge font-mono">{dateStr}</span>
      </div>
    </div>

    <!-- Title — styled as a shell prompt -->
    <div class="wcard-prompt">
      <span class="prompt-symbol font-mono">$</span>
      <h3 class="wcard-title font-mono">{titulo}</h3>
    </div>

    <!-- Description -->
    <p class="wcard-desc">{descripcion}</p>

    <!-- Attack Chain Pills -->
    <div class="attack-chain">
      {phases.map((phase, i) => (
        <div class="chain-step">
          <span class="chain-label font-mono">{phase}</span>
          {i < phases.length - 1 && <span class="chain-arrow">→</span>}
        </div>
      ))}
    </div>

    <!-- Tools used -->
    <div class="wcard-tools">
      {herramientas.slice(0, 5).map(tool => (
        <span class="tool-pill font-mono">
          <span class="tool-hash">#</span>{tool}
        </span>
      ))}
      {herramientas.length > 5 && (
        <span class="tool-more font-mono">+{herramientas.length - 5}</span>
      )}
    </div>

    <!-- CTA -->
    <a href={`${base}/writeups/${slug}`} class="wcard-cta btn-primary" aria-label={`Leer writeup de ${titulo}`}>
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
      </svg>
      cat writeup.md
    </a>
  </div>
</article>

<style>
  /* ── Card shell ─────────────────────────────────────────────── */
  .wcard {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    position: relative;
  }
  .wcard::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-neon-cyan), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .wcard:hover {
    border-color: rgba(34, 211, 238, 0.45);
    box-shadow: 0 6px 32px rgba(34, 211, 238, 0.09);
    transform: translateY(-3px);
  }
  .wcard:hover::before { opacity: 1; }

  /* ── Chrome bar ─────────────────────────────────────────────── */
  .wcard-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: 0.5rem 0.9rem;
  }
  .chrome-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .chrome-title {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-left: 0.5rem;
  }

  /* ── Body ───────────────────────────────────────────────────── */
  .wcard-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .wcard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .wcard-platform {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .plat-icon { font-size: 1rem; }
  .plat-name {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
  .wcard-badges { display: flex; align-items: center; gap: 0.5rem; }
  .date-badge {
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }
  .diff-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Prompt title ───────────────────────────────────────────── */
  .wcard-prompt {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .prompt-symbol {
    color: var(--color-neon-green);
    font-size: 0.9rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
  }
  .wcard-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.35;
  }

  /* ── Description ────────────────────────────────────────────── */
  .wcard-desc {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-border-subtle);
  }

  /* ── Attack chain ───────────────────────────────────────────── */
  .attack-chain {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    padding: 0.45rem 0.65rem;
    background: rgba(34,211,238,0.03);
    border: 1px solid rgba(34,211,238,0.1);
    border-radius: 0.4rem;
  }
  .chain-step {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .chain-label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neon-cyan);
  }
  .chain-arrow {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* ── Tools ──────────────────────────────────────────────────── */
  .wcard-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tool-pill {
    font-size: 0.68rem;
    padding: 0.18rem 0.55rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.35rem;
    color: var(--color-neon-green);
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s;
  }
  .tool-pill:hover {
    border-color: rgba(74,222,128,0.4);
    color: #6ee7a0;
  }
  .tool-hash {
    color: var(--color-text-muted);
    margin-right: 0.15rem;
  }
  .tool-more {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    padding: 0.18rem 0.4rem;
  }

  /* ── CTA ────────────────────────────────────────────────────── */
  .wcard-cta {
    margin-top: auto;
    width: 100%;
    justify-content: center;
    font-size: 0.78rem;
  }
</style>
