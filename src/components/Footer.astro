---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="footer-root">
  <div class="mx-auto px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Brand -->
      <div class="flex flex-col gap-1">
        <span class="footer-brand">
          Carlos <span class="footer-brand-accent">Santiago</span> Patiño
        </span>
        <span class="footer-sub">
          Ingeniería de Sistemas · Ciberseguridad
        </span>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-5">
        <a href={`${base}/proyectos`} class="footer-link">Proyectos</a>
        <a href={`${base}/writeups`} class="footer-link">Writeups</a>
        <a
          href="https://github.com/SantiagoP0815"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link flex items-center gap-1.5"
        >
          <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
          GitHub
        </a>
      </div>

      <!-- Copyright -->
      <div class="footer-copy">
        © {year} Carlos Santiago Patiño Reyes
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-root {
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-bg-primary);
    margin-top: 6rem;
  }
  .footer-brand {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }
  .footer-brand-accent { color: var(--color-neon-cyan); }
  .footer-sub {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
  .footer-link {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    font-weight: 500;
  }
  .footer-link:hover { color: var(--color-neon-cyan); }
  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }
</style>
