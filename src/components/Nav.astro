---
const navLinks = [
  { href: '/', label: '~/inicio' },
  { href: '/proyectos', label: '~/proyectos' },
  { href: '/writeups', label: '~/writeups' },
];

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header id="main-nav" class="sticky top-0 z-50">
  <div class="nav-backdrop"></div>
  <nav class="relative max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo / Brand -->
    <a href={`${base}/`} class="flex items-center gap-2 group" aria-label="Inicio">
      <div class="logo-icon">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polygon points="14,2 26,8 26,20 14,26 2,20 2,8" stroke="currentColor" stroke-width="1.5" fill="none" class="text-cyan-400"/>
          <polygon points="14,6 22,10 22,18 14,22 6,18 6,10" stroke="currentColor" stroke-width="1" fill="none" class="text-cyan-400" opacity="0.5"/>
          <circle cx="14" cy="14" r="3" fill="currentColor" class="text-cyan-400"/>
        </svg>
      </div>
      <span class="font-mono font-bold text-lg tracking-tight" style="color: var(--color-neon-cyan)">
        sec<span style="color: var(--color-text-primary)">portfolio</span>
      </span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map(link => {
        const href = `${base}${link.href}`;
        const isActive = currentPath === href || (link.href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class={`nav-link font-mono text-sm px-3 py-2 rounded-md transition-all duration-200 ${isActive ? 'nav-link-active' : ''}`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <!-- Status indicator -->
    <div class="hidden md:flex items-center gap-2">
      <div class="w-2 h-2 rounded-full animate-pulse" style="background: var(--color-neon-green); box-shadow: 0 0 6px var(--color-neon-green)"></div>
      <span class="font-mono text-xs" style="color: var(--color-text-muted)">available</span>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md" style="color: var(--color-text-secondary)" aria-label="Menu">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t" style="border-color: var(--color-border-subtle); background: var(--color-bg-primary)">
    <div class="px-6 py-4 flex flex-col gap-2">
      {navLinks.map(link => {
        const href = `${base}${link.href}`;
        return (
          <a href={href} class="nav-link font-mono text-sm px-3 py-2 rounded-md">
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</header>

<style>
  #main-nav {
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .nav-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 10, 15, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .nav-link {
    color: var(--color-text-secondary);
  }
  .nav-link:hover {
    color: var(--color-neon-cyan);
    background: rgba(0, 245, 255, 0.06);
  }
  .nav-link-active {
    color: var(--color-neon-cyan) !important;
    background: rgba(0, 245, 255, 0.08) !important;
  }
  .logo-icon {
    color: var(--color-neon-cyan);
    filter: drop-shadow(0 0 6px var(--color-neon-cyan));
    transition: filter 0.3s ease;
  }
  .logo-icon:hover {
    filter: drop-shadow(0 0 12px var(--color-neon-cyan));
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
