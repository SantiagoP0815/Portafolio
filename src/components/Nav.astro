---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/writeups', label: 'Writeups' },
];

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header id="main-nav" class="sticky top-0 z-50">
  <div class="nav-backdrop"></div>
  <nav class="relative max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Brand / Name -->
    <a href={`${base}/`} class="brand-link group" aria-label="Inicio">
      <span class="brand-name">
        <span class="brand-first">Carlos</span>
        <span class="brand-last">Patiño</span>
      </span>
      <span class="brand-tag">sec</span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map(link => {
        const href = `${base}${link.href}`;
        const isActive = currentPath === href || (link.href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class={`nav-link text-sm px-4 py-2 rounded-md transition-all duration-200 ${isActive ? 'nav-link-active' : ''}`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <!-- Status indicator -->
    <div class="hidden md:flex items-center gap-2">
      <div class="status-dot"></div>
      <span class="status-text">disponible</span>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md" style="color: var(--color-text-secondary)" aria-label="Menu">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t" style="border-color: var(--color-border-subtle); background: var(--color-bg-primary)">
    <div class="px-6 py-4 flex flex-col gap-2">
      {navLinks.map(link => {
        const href = `${base}${link.href}`;
        return (
          <a href={href} class="nav-link text-sm px-3 py-2 rounded-md">
            {link.label}
          </a>
        );
      })}
    </div>
  </div>
</header>

<style>
  #main-nav {
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .nav-backdrop {
    position: absolute; inset: 0;
    background: rgba(8, 13, 18, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* Brand */
  .brand-link {
    display: flex; align-items: center; gap: 0.5rem;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    transition: color 0.2s;
  }
  .brand-first { color: var(--color-text-primary); }
  .brand-last  { color: var(--color-neon-cyan); }
  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-neon-cyan);
    background: rgba(34,211,238,0.08);
    border: 1px solid rgba(34,211,238,0.25);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.2s;
  }
  .brand-link:hover .brand-tag {
    background: rgba(34,211,238,0.14);
    box-shadow: 0 0 10px rgba(34,211,238,0.2);
  }

  /* Nav links */
  .nav-link {
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(255,255,255,0.04);
  }
  .nav-link-active {
    color: var(--color-neon-cyan) !important;
    background: rgba(34,211,238,0.07) !important;
  }

  /* Status */
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--color-neon-green);
    box-shadow: 0 0 7px var(--color-neon-green);
    animation: pulse 2s ease-in-out infinite;
  }
  .status-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
