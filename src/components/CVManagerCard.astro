---
// CVManagerCard.astro — Tarjeta destacada especial para el Sistema de Gestión de CVs
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cv-card-wrapper" aria-label="Proyecto Destacado: Sistema de Gestión de CVs">
  <!-- Header badge -->
  <div class="featured-badge">
    <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
      <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
    </svg>
    PROYECTO DESTACADO
  </div>

  <div class="cv-card">
    <!-- Decorative corner lines -->
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <!-- ── Header ── -->
    <div class="cv-header">
      <div class="project-id">
        <span class="font-mono text-xs" style="color: var(--color-text-muted)"># sistema_gestion_cvs.v1.0</span>
      </div>
      <h2 class="cv-title">Sistema de Gestión de CVs</h2>
      <p class="cv-description">
        Plataforma web full-stack para gestión centralizada de currículums vitae con autenticación segura, 
        panel de administración y arquitectura MVC robusta.
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        <span class="tag-badge tag-cyan">Node.js</span>
        <span class="tag-badge tag-green">MySQL</span>
        <span class="tag-badge tag-purple">Express</span>
        <span class="tag-badge tag-pink">Passport.js</span>
        <span class="tag-badge tag-orange">bcrypt</span>
        <span class="tag-badge tag-cyan">Multer</span>
        <span class="tag-badge tag-green">pdfmake</span>
      </div>
    </div>

    <!-- ── Architecture Section ── -->
    <div class="cv-section">
      <h3 class="section-title">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3"/>
        </svg>
        Arquitectura
      </h3>

      <!-- MVC Flow Diagram -->
      <div class="mvc-diagram">
        <div class="mvc-layer">
          <div class="layer-icon browser-icon">🌐</div>
          <div class="layer-label">Cliente<br/><span>Browser</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon route-icon">⚡</div>
          <div class="layer-label">Routes<br/><span>Express.js</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon ctrl-icon">⚙️</div>
          <div class="layer-label">Controller<br/><span>Lógica</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon model-icon">📦</div>
          <div class="layer-label">Repository<br/><span>mysql2</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon db-icon">🗄️</div>
          <div class="layer-label">Database<br/><span>MySQL</span></div>
        </div>
      </div>

      <!-- Tech Stack Grid -->
      <div class="tech-grid">
        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-green)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1.85c-.27 0-.55.07-.78.2l-7.44 4.3c-.48.28-.78.8-.78 1.36v8.58c0 .56.3 1.08.78 1.36l1.95 1.12c.95.46 1.27.47 1.71.47 1.4 0 2.21-.85 2.21-2.33V8.44c0-.12-.1-.22-.22-.22H8.5c-.13 0-.23.1-.23.22v8.47c0 .66-.68 1.31-1.77.76L4.45 16.5a.26.26 0 01-.11-.21V7.71c0-.09.04-.17.11-.21l7.44-4.29c.06-.04.16-.04.22 0l7.44 4.29c.07.04.11.12.11.21v8.58c0 .08-.04.16-.11.21l-7.44 4.29c-.06.04-.16.04-.23 0L10 19.65c-.08-.03-.16-.04-.21-.01-.53.3-.63.36-1.12.51-.12.04-.31.11.07.32l2.48 1.47c.24.14.5.21.78.21s.54-.07.78-.21l7.44-4.29c.48-.28.78-.8.78-1.36V7.71c0-.56-.3-1.08-.78-1.36L12.78 2.05c-.23-.13-.5-.2-.78-.2z"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">Node.js</span>
            <span class="tech-desc">Runtime JS del servidor</span>
          </div>
        </div>

        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-cyan)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 18.588a1.529 1.529 0 01-1.895-.72l-3.45-4.771-.5-.667-4.003 5.444a1.466 1.466 0 01-1.802.708l5.158-6.92-4.798-6.251a1.595 1.595 0 011.9.666l3.576 4.83 3.596-4.81a1.435 1.435 0 011.788-.668L21.708 7.9l-2.522 3.283a.666.666 0 000 .994l4.804 6.412zM.002 11.576l.42-2.075c1.154-4.103 5.858-5.81 9.094-3.27 1.895 1.489 2.368 3.597 2.275 5.973H1.116C.943 16.447 4.005 19.009 7.92 17.7a4.078 4.078 0 002.582-2.876c.207-.666.548-.78 1.174-.588a5.417 5.417 0 01-2.589 3.957 6.272 6.272 0 01-7.306-.933 6.575 6.575 0 01-1.64-3.858c0-.235-.08-.455-.138-.82zm1.158-.228h9.386c-.084-2.481-1.88-4.109-4.55-4.038-2.Hearts.07-4.62 1.82-4.836 4.038z"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">Express.js</span>
            <span class="tech-desc">Framework web MVC</span>
          </div>
        </div>

        <div class="tech-item">
          <div class="tech-icon" style="color: #4479A1">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16.405 5.501c-.115 0-.193.014-.274.033v.013h.014c.054.104.146.18.214.273.054.107.1.214.154.32l.014-.015c.094-.066.14-.172.14-.333-.04-.047-.046-.094-.062-.14a.522.522 0 00-.2-.151zM12 1C5.926 1 1 5.918 1 11.985 1 18.053 5.926 23 12 23s11-4.947 11-11.015C23 5.918 18.074 1 12 1zm0 2c4.949 0 9 4.015 9 8.985 0 4.979-4.051 9.015-9 9.015-4.949 0-9-4.036-9-9.015C3 7.015 7.051 3 12 3z"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">MySQL</span>
            <span class="tech-desc">Base de datos relacional</span>
          </div>
        </div>

        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-purple)">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">Passport.js</span>
            <span class="tech-desc">Auth local strategy + sesiones MySQL</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Security Section ── -->
    <div class="cv-section">
      <h3 class="section-title" style="color: var(--color-neon-green)">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 10c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.249-8.25-3.286z"/>
        </svg>
        Medidas de Seguridad
      </h3>

      <div class="security-grid">
        <div class="security-item">
          <div class="security-icon">🔐</div>
          <div>
            <div class="security-label">Passwords con bcrypt</div>
            <div class="security-detail">Hash seguro — resistente a ataques de fuerza bruta y rainbow tables</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">🪪</div>
          <div>
            <div class="security-label">Passport.js + Sessions</div>
            <div class="security-detail">Autenticación local strategy, sesiones en MySQL con express-mysql-session</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">🛡️</div>
          <div>
            <div class="security-label">Helmet.js — HTTP Headers</div>
            <div class="security-detail">CSP, HSTS, X-Frame-Options, X-Content-Type-Options configurados</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">⏱️</div>
          <div>
            <div class="security-label">Rate Limiting</div>
            <div class="security-detail">100 req / 15 min por IP — mitiga ataques de fuerza bruta y DoS</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">🚫</div>
          <div>
            <div class="security-label">SQL Injection Prevention</div>
            <div class="security-detail">Queries parametrizadas con mysql2 — cero concatenación de strings en SQL</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">✅</div>
          <div>
            <div class="security-label">Input Validation</div>
            <div class="security-detail">express-validator sanitiza y valida todos los inputs del usuario</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">🔑</div>
          <div>
            <div class="security-label">Secrets en .env</div>
            <div class="security-detail">SESSION_SECRET, credenciales DB y configs sensibles fuera del repositorio</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">📁</div>
          <div>
            <div class="security-label">Upload seguro con Multer</div>
            <div class="security-detail">Validación de tipo y tamaño en subida de documentos PDF e imágenes</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer CTA -->
    <div class="cv-footer">
      <a href="https://github.com/SantiagoP0815/HojaDeVida" target="_blank" rel="noopener noreferrer" class="btn-primary">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        Ver Código en GitHub
      </a>
      <a href={`${base}/proyectos/gestion-cvs`} class="btn-ghost">
        Ver proyecto →
      </a>
    </div>
  </div>
</section>

<style>
  .cv-card-wrapper {
    position: relative;
    margin: 2rem 0;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-neon-cyan);
    background: rgba(0, 245, 255, 0.08);
    border: 1px solid rgba(0, 245, 255, 0.3);
    border-radius: 9999px;
    margin-bottom: 0.6rem;
    position: relative;
    z-index: 1;
  }

  .cv-card {
    position: relative;
    background: var(--color-bg-card);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 0.75rem;
    padding: 2rem;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(0, 245, 255, 0.08), inset 0 0 40px rgba(0, 245, 255, 0.02);
    animation: pulseNeon 4s ease-in-out infinite;
  }

  .cv-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-neon-cyan), transparent);
  }

  /* Corner decorations */
  .corner {
    position: absolute;
    width: 16px;
    height: 16px;
  }
  .corner-tl { top: 8px; left: 8px; border-top: 2px solid var(--color-neon-cyan); border-left: 2px solid var(--color-neon-cyan); }
  .corner-tr { top: 8px; right: 8px; border-top: 2px solid var(--color-neon-cyan); border-right: 2px solid var(--color-neon-cyan); }
  .corner-bl { bottom: 8px; left: 8px; border-bottom: 2px solid var(--color-neon-cyan); border-left: 2px solid var(--color-neon-cyan); }
  .corner-br { bottom: 8px; right: 8px; border-bottom: 2px solid var(--color-neon-cyan); border-right: 2px solid var(--color-neon-cyan); }

  /* Header */
  .cv-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .project-id {
    margin-bottom: 0.5rem;
  }

  .cv-title {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .cv-description {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 70ch;
  }

  /* Sections */
  .cv-section {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-neon-cyan);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  /* MVC Diagram */
  .mvc-diagram {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
  }

  .mvc-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 64px;
  }

  .layer-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 0 6px var(--color-neon-cyan));
  }

  .layer-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-align: center;
    line-height: 1.3;
  }
  .layer-label span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .mvc-arrow {
    font-family: var(--font-mono);
    color: var(--color-neon-cyan);
    font-size: 1.2rem;
    opacity: 0.6;
  }

  /* Tech Grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease;
  }
  .tech-item:hover {
    border-color: var(--color-neon-cyan)66;
  }

  .tech-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .tech-desc {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Security Grid */
  .security-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .security-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem;
    background: rgba(57, 255, 20, 0.03);
    border: 1px solid rgba(57, 255, 20, 0.15);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }
  .security-item:hover {
    border-color: rgba(57, 255, 20, 0.35);
    background: rgba(57, 255, 20, 0.06);
  }

  .security-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .security-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-neon-green);
    margin-bottom: 0.2rem;
  }
  .security-detail {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Footer */
  .cv-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
</style>
