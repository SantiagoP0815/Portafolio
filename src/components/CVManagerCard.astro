---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cv-card-wrapper" aria-label="Proyecto Destacado: Scanner de Vulnerabilidades Web">
  <!-- Header badge -->
  <div class="featured-badge">
    <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
      <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
    </svg>
    PROYECTO DESTACADO
  </div>

  <div class="cv-card">
    <!-- Decorative corner lines -->
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <!-- ── Header ── -->
    <div class="cv-header">
      <div class="project-id">
        <span class="font-mono text-xs" style="color: var(--color-text-muted)"># vuln_scanner.v1.0</span>
      </div>
      <h2 class="cv-title">Scanner de Vulnerabilidades Web</h2>
      <p class="cv-description">
        Herramienta CLI en Python para detección automatizada de vulnerabilidades OWASP Top 10:
        cabeceras de seguridad, XSS reflejado, SQL injection, open redirect y directory listing.
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        <span class="tag-badge tag-cyan">Python</span>
        <span class="tag-badge tag-green">requests</span>
        <span class="tag-badge tag-purple">BeautifulSoup</span>
        <span class="tag-badge tag-orange">argparse</span>
        <span class="tag-badge tag-pink">OWASP Top 10</span>
      </div>
    </div>

    <!-- ── Architecture Section ── -->
    <div class="cv-section">
      <h3 class="section-title">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3"/>
        </svg>
        Arquitectura
      </h3>

      <!-- Pipeline Diagram -->
      <div class="mvc-diagram">
        <div class="mvc-layer">
          <div class="layer-icon">⌨️</div>
          <div class="layer-label">CLI<br/><span>argparse</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon">⚙️</div>
          <div class="layer-label">scanner.py<br/><span>Orquestador</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon">🔍</div>
          <div class="layer-label">modules/<br/><span>5 detectores</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon">🌐</div>
          <div class="layer-label">utils/http<br/><span>HTTP client</span></div>
        </div>
        <div class="mvc-arrow">→</div>
        <div class="mvc-layer">
          <div class="layer-icon">📄</div>
          <div class="layer-label">reporter<br/><span>JSON + CLI</span></div>
        </div>
      </div>

      <!-- Tech Stack Grid -->
      <div class="tech-grid">
        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-cyan)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.25.18l.9.2.73.26.59.3.45.32.34.34.25.34.16.33.1.3.04.26.02.2-.01.13V8.5l-.05.63-.13.55-.21.46-.26.38-.3.31-.33.25-.35.19-.35.14-.33.1-.3.07-.26.04-.21.02H8.83l-.69.05-.59.14-.5.22-.41.27-.33.32-.27.35-.2.36-.15.37-.1.35-.07.32-.04.27-.02.21v3.06H3.23l-.21-.03-.28-.07-.32-.12-.35-.18-.36-.26-.36-.36-.35-.46-.32-.59-.28-.73-.21-.88-.14-1.05-.05-1.23.06-1.22.16-1.04.24-.87.32-.71.36-.57.4-.44.42-.33.42-.24.4-.16.36-.1.32-.05.24-.01h.16l.06.01h8.16v-.83H6.24l-.01-2.75-.02-.37.05-.34.11-.31.17-.28.25-.26.31-.23.38-.2.44-.18.51-.15.58-.12.64-.1.71-.06.77-.04.84-.02 1.27.05 1.07.13zm-6.3 1.98l-.23.33-.08.41.08.41.23.34.33.22.41.09.41-.09.33-.22.23-.34.08-.41-.08-.41-.23-.33-.33-.22-.41-.09-.41.09-.33.22zM21.1 6.11l.28.06.32.12.35.18.36.27.36.35.35.47.32.59.28.73.21.88.14 1.04.05 1.23-.06 1.23-.16 1.04-.24.86-.32.71-.36.57-.4.45-.42.33-.42.24-.4.16-.36.09-.32.05-.24.02-.16-.01h-8.22v.82h5.84l.01 2.76.02.36-.05.34-.11.31-.17.29-.25.25-.31.24-.38.2-.44.17-.51.15-.58.13-.64.09-.71.07-.77.04-.84.01-1.27-.04-1.07-.14-.9-.2-.73-.25-.59-.3-.45-.33-.34-.34-.25-.34-.16-.33-.1-.3-.04-.25-.02-.2.01-.13v-5.34l.05-.64.13-.54.21-.46.26-.38.3-.31.33-.25.35-.19.35-.14.33-.1.3-.06.26-.04.21-.02.13-.01h5.84l.69-.05.59-.14.5-.21.41-.28.33-.32.27-.35.2-.36.15-.36.1-.35.07-.32.04-.28.02-.21V6.07h2.09l.14.04zm-6.47 14.25l-.23.33-.08.41.08.41.23.33.33.23.41.08.41-.08.33-.23.23-.33.08-.41-.08-.41-.23-.33-.33-.23-.41-.08-.41.08-.33.23z"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">Python 3</span>
            <span class="tech-desc">Lenguaje principal del proyecto</span>
          </div>
        </div>

        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-green)">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253M3.284 14.253A8.959 8.959 0 013 12c0-.778.099-1.533.284-2.253"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">requests</span>
            <span class="tech-desc">Cliente HTTP + manejo de sesiones</span>
          </div>
        </div>

        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-purple)">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">BeautifulSoup</span>
            <span class="tech-desc">Parsing HTML y extracción de forms</span>
          </div>
        </div>

        <div class="tech-item">
          <div class="tech-icon" style="color: var(--color-neon-orange, #fb923c)">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/>
            </svg>
          </div>
          <div class="tech-info">
            <span class="tech-name">argparse + threading</span>
            <span class="tech-desc">CLI modular y ejecución concurrente</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Detection Modules Section ── -->
    <div class="cv-section">
      <h3 class="section-title" style="color: var(--color-neon-green)">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 10c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.249-8.25-3.286z"/>
        </svg>
        Módulos de Detección (OWASP Top 10)
      </h3>

      <div class="security-grid">
        <div class="security-item">
          <div class="security-icon">🛡️</div>
          <div>
            <div class="security-label">headers</div>
            <div class="security-detail">Detecta cabeceras de seguridad ausentes: HSTS, CSP, X-Frame-Options, Referrer-Policy, Permissions-Policy</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">⚡</div>
          <div>
            <div class="security-label">xss</div>
            <div class="security-detail">Inyecta payloads de XSS reflejado en parámetros URL y campos de formularios GET/POST</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">💉</div>
          <div>
            <div class="security-label">sqli</div>
            <div class="security-detail">Detección error-based de SQL Injection — firmas para MySQL, PostgreSQL, Oracle y SQLite</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">↪️</div>
          <div>
            <div class="security-label">redirect</div>
            <div class="security-detail">Prueba parámetros comunes (url, next, redirect, goto…) para detectar Open Redirects</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">📂</div>
          <div>
            <div class="security-label">dirlisting</div>
            <div class="security-detail">Verifica rutas sensibles expuestas: directory listing activo, .git/, .env, paneles de administración</div>
          </div>
        </div>

        <div class="security-item">
          <div class="security-icon">📊</div>
          <div>
            <div class="security-label">reporter</div>
            <div class="security-detail">Salida en consola con colores por severidad (HIGH / MEDIUM / LOW / INFO) + exportación JSON</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer CTA -->
    <div class="cv-footer">
      <a href="https://github.com/SantiagoP0815/vuln-scanner" target="_blank" rel="noopener noreferrer" class="btn-primary">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        Ver Código en GitHub
      </a>
      <a href={`${base}/proyectos/vuln-scanner`} class="btn-ghost">
        Ver proyecto →
      </a>
    </div>
  </div>
</section>

<style>
  .cv-card-wrapper {
    position: relative;
    margin: 2rem 0;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-neon-cyan);
    background: rgba(0, 245, 255, 0.08);
    border: 1px solid rgba(0, 245, 255, 0.3);
    border-radius: 9999px;
    margin-bottom: 0.6rem;
    position: relative;
    z-index: 1;
  }

  .cv-card {
    position: relative;
    background: var(--color-bg-card);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 0.75rem;
    padding: 2rem;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(0, 245, 255, 0.08), inset 0 0 40px rgba(0, 245, 255, 0.02);
    animation: pulseNeon 4s ease-in-out infinite;
  }

  .cv-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-neon-cyan), transparent);
  }

  /* Corner decorations */
  .corner {
    position: absolute;
    width: 16px;
    height: 16px;
  }
  .corner-tl { top: 8px; left: 8px; border-top: 2px solid var(--color-neon-cyan); border-left: 2px solid var(--color-neon-cyan); }
  .corner-tr { top: 8px; right: 8px; border-top: 2px solid var(--color-neon-cyan); border-right: 2px solid var(--color-neon-cyan); }
  .corner-bl { bottom: 8px; left: 8px; border-bottom: 2px solid var(--color-neon-cyan); border-left: 2px solid var(--color-neon-cyan); }
  .corner-br { bottom: 8px; right: 8px; border-bottom: 2px solid var(--color-neon-cyan); border-right: 2px solid var(--color-neon-cyan); }

  /* Header */
  .cv-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .project-id {
    margin-bottom: 0.5rem;
  }

  .cv-title {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .cv-description {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 70ch;
  }

  /* Sections */
  .cv-section {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-neon-cyan);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  /* Pipeline Diagram */
  .mvc-diagram {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
  }

  .mvc-layer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 64px;
  }

  .layer-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 0 6px var(--color-neon-cyan));
  }

  .layer-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-primary);
    text-align: center;
    line-height: 1.3;
  }
  .layer-label span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .mvc-arrow {
    font-family: var(--font-mono);
    color: var(--color-neon-cyan);
    font-size: 1.2rem;
    opacity: 0.6;
  }

  /* Tech Grid */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease;
  }
  .tech-item:hover {
    border-color: var(--color-neon-cyan)66;
  }

  .tech-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .tech-desc {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 0.1rem;
  }

  /* Detection Modules Grid */
  .security-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  .security-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem;
    background: rgba(57, 255, 20, 0.03);
    border: 1px solid rgba(57, 255, 20, 0.15);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }
  .security-item:hover {
    border-color: rgba(57, 255, 20, 0.35);
    background: rgba(57, 255, 20, 0.06);
  }

  .security-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .security-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-neon-green);
    margin-bottom: 0.2rem;
  }
  .security-detail {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Footer */
  .cv-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
</style>
