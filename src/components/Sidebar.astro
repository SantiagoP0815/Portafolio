---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const allProjects = await getCollection('projects');
const allWriteups  = await getCollection('writeups');

const navLinks = [
  { href: '/',          label: 'Inicio',    icon: 'home',     count: null                },
  { href: '/projects',  label: 'Proyectos', icon: 'folder',   count: allProjects.length },
  { href: '/writeups',  label: 'Writeups',  icon: 'terminal', count: allWriteups.length },
  { href: '/cv',        label: 'CV',        icon: 'document', count: null                },
] as const;

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside id="sidebar">

  <!-- Móvil: barra superior fija -->
  <div class="mobile-topbar">
    <a href={`${base}/`} class="mobile-brand">
      <span class="brand-name">
        <span class="brand-first">Carlos</span><span class="brand-last"> Patiño</span>
      </span>
      <span class="brand-tag">sec</span>
    </a>
    <button id="sidebar-open-btn" class="icon-btn" aria-label="Abrir menú" aria-controls="sidebar-panel" aria-expanded="false">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
  </div>

  <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

  <nav id="sidebar-panel" class="sidebar-panel" aria-label="Navegación principal">

    <button id="sidebar-close-btn" class="icon-btn sidebar-close" aria-label="Cerrar menú">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Avatar + marca: un solo enlace al inicio -->
    <a href={`${base}/`} class="sidebar-brand">
      <img class="avatar" src={`${base}/perfil.jpg`} alt="" width="48" height="48" decoding="async" />
      <span class="brand-info">
        <span class="brand-line">
          <span class="brand-name">
            <span class="brand-first">Carlos</span><span class="brand-last"> Patiño</span>
          </span>
          <span class="brand-tag">sec</span>
        </span>
        <span class="brand-role">Ing. de Sistemas · Ciberseguridad</span>
      </span>
    </a>
    <p class="status-row">
      <span class="status-dot" aria-hidden="true"></span>
      Disponible para trabajar
    </p>

    <div class="sidebar-divider"></div>

    <ul class="sidebar-nav" role="list">
      {navLinks.map(link => {
        const resolvedHref = link.href === '/' ? `${base}/` : `${base}${link.href}`;
        const isActive = link.href === '/'
          ? (currentPath === `${base}/` || currentPath === `${base}` || currentPath === `${base}/index`)
          : currentPath.startsWith(`${base}${link.href}`);
        return (
          <li>
            <a
              href={resolvedHref}
              class:list={['sidebar-link', { 'sidebar-link-active': isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              <Icon name={link.icon} size={18} />
              <span>{link.label}</span>
              {link.count !== null && (
                <span class="nav-count" aria-label={`${link.count} publicados`}>{link.count}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="sidebar-spacer"></div>
    <div class="sidebar-divider"></div>

    <h2 class="sr-only">Contacto</h2>
    <ul class="sidebar-social" role="list">
      <li>
        <a href="mailto:santiago.p.0815@gmail.com" class="social-link">
          <Icon name="mail" size={16} />
          <span>Email</span>
        </a>
      </li>
      <li>
        <a href="https://github.com/SantiagoP0815" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg class="icon" width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
          <span>GitHub</span>
          <span class="sr-only">(abre en otra pestaña)</span>
        </a>
      </li>
      <li>
        <a href="https://linkedin.com/in/carlos-santiago-patino-reyes" target="_blank" rel="noopener noreferrer" class="social-link">
          <svg class="icon" width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <span>LinkedIn</span>
          <span class="sr-only">(abre en otra pestaña)</span>
        </a>
      </li>
    </ul>

  </nav>
</aside>

<style>
  /* ── Panel (escritorio) ───────────────────────────────────── */
  .sidebar-panel {
    position: fixed;
    top: 0; left: 0;
    width: 240px;
    height: 100vh;
    height: 100dvh;
    background: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem 1.25rem;
    z-index: 100;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ── Marca ───────────────────────────────────────────────── */
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.25rem;
    border-radius: 0.6rem;
    text-decoration: none;
  }
  .avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(34,211,238,0.35);
    flex-shrink: 0;
  }
  .brand-info { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .brand-line { display: inline-flex; align-items: center; gap: 0.45rem; }
  .brand-name {
    font-family: var(--font-sans);
    font-weight: 700; font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  .brand-first { color: var(--color-text-primary); }
  .brand-last  { color: var(--color-neon-cyan); }
  .brand-tag {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
    color: var(--color-neon-cyan);
    border: 1px solid rgba(34,211,238,0.3);
    padding: 0 0.35rem; border-radius: 4px;
    text-transform: uppercase;
  }
  .brand-role {
    font-size: 0.8rem; color: var(--color-text-secondary);
    line-height: 1.3;
  }
  .status-row {
    display: flex; align-items: center; gap: 0.5rem;
    margin: 0.75rem 0 0 0.35rem;
    font-size: 0.8rem; color: var(--color-neon-green);
  }
  .status-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-neon-green);
    flex-shrink: 0;
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-border-subtle);
    margin: 1rem 0;
  }

  /* ── Navegación ──────────────────────────────────────────── */
  .sidebar-nav {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .sidebar-link {
    display: flex; align-items: center; gap: 0.7rem;
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    position: relative;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .sidebar-link:hover {
      background: rgba(255,255,255,0.04);
      color: var(--color-text-primary);
    }
  }
  .sidebar-link-active {
    color: var(--color-neon-cyan);
    background: rgba(34,211,238,0.08);
  }
  .sidebar-link-active::before {
    content: '';
    position: absolute; left: 0; top: 0.6rem; bottom: 0.6rem;
    width: 2px;
    background: var(--color-neon-cyan);
    border-radius: 0 2px 2px 0;
  }
  .nav-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    min-width: 1.6rem;
    text-align: center;
    padding: 0 0.4rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .sidebar-link-active .nav-count {
    border-color: rgba(34,211,238,0.35);
    color: var(--color-neon-cyan);
  }

  /* ── Contacto ────────────────────────────────────────────── */
  .sidebar-spacer { flex: 1; }
  .sidebar-social {
    list-style: none; padding: 0;
    display: flex; flex-direction: column; gap: 0.1rem;
  }
  .social-link {
    display: flex; align-items: center; gap: 0.65rem;
    min-height: 40px;
    padding: 0.45rem 0.75rem; border-radius: 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      color: var(--color-text-primary);
      background: rgba(255,255,255,0.04);
    }
  }

  /* ── Botones de icono (móvil) ────────────────────────────── */
  .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    background: transparent; border: none;
    color: var(--color-text-primary); cursor: pointer;
    border-radius: 0.5rem;
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .icon-btn:active { transform: scale(0.94); background: rgba(255,255,255,0.06); }

  .sidebar-close { display: none; }
  .mobile-topbar { display: none; }

  .sidebar-backdrop {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 99;
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
  }

  .mobile-brand {
    display: inline-flex; align-items: center; gap: 0.45rem;
    min-height: 44px;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .mobile-topbar {
      display: flex; align-items: center; justify-content: space-between;
      position: fixed; top: 0; left: 0; right: 0; height: 56px;
      padding: 0 0.5rem 0 1rem;
      background: rgba(8,13,18,0.94);
      border-bottom: 1px solid var(--color-border-subtle);
      z-index: 101;
    }

    /* Panel: fuera de pantalla; entra con curva de cajón y sale más rápido */
    .sidebar-panel {
      width: min(280px, 85vw);
      padding-top: 3.75rem;               /* deja sitio a la ✕ encima de la marca */
      z-index: 103;
      transform: translateX(-100%);
      transition: transform 200ms var(--ease-out);
    }
    .sidebar-panel.sidebar-open {
      transform: translateX(0);
      transition: transform 280ms var(--ease-drawer);
    }

    .sidebar-close {
      display: inline-flex;
      position: absolute; top: 0.5rem; right: 0.5rem;
    }

    .sidebar-backdrop {
      display: block;
      pointer-events: none;
      z-index: 102;
    }
    .sidebar-backdrop.backdrop-visible {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  const openBtn    = document.getElementById('sidebar-open-btn');
  const closeBtn   = document.getElementById('sidebar-close-btn');
  const backdrop   = document.getElementById('sidebar-backdrop');
  const panel      = document.getElementById('sidebar-panel');
  const mobileQuery = window.matchMedia('(max-width: 767px)');

  let isOpen = false;

  // En móvil, el panel cerrado queda fuera de pantalla: `inert` evita que
  // sus enlaces reciban foco con Tab o sean leídos por lectores de pantalla.
  function syncInert() {
    if (!panel) return;
    panel.inert = mobileQuery.matches && !isOpen;
  }

  function openSidebar() {
    isOpen = true;
    panel?.classList.add('sidebar-open');
    backdrop?.classList.add('backdrop-visible');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    syncInert();
    closeBtn?.focus();
  }
  function closeSidebar() {
    if (!isOpen) return;
    isOpen = false;
    panel?.classList.remove('sidebar-open');
    backdrop?.classList.remove('backdrop-visible');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    syncInert();
    openBtn?.focus();
  }

  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  backdrop?.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
  mobileQuery.addEventListener('change', () => {
    if (!mobileQuery.matches && isOpen) closeSidebar();
    syncInert();
  });
  syncInert();
</script>
