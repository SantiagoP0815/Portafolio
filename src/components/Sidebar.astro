---
import { getCollection } from 'astro:content';

const allProyectos = await getCollection('proyectos');
const allWriteups  = await getCollection('writeups');

const navLinks = [
  { href: '/',          label: 'whoami',    icon: 'home',     count: null                  },
  { href: '/proyectos', label: 'proyectos', icon: 'folder',   count: allProyectos.length   },
  { href: '/writeups',  label: 'writeups',  icon: 'terminal', count: allWriteups.length    },
];

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside id="sidebar">

  <!-- Mobile: fixed top bar ─────────────────────────────────── -->
  <div class="mobile-topbar">
    <a href={`${base}/`} class="mobile-brand" aria-label="Inicio">
      <span class="brand-name">
        <span class="brand-first">Carlos</span><span class="brand-last"> Patiño</span>
      </span>
      <span class="brand-tag">sec</span>
    </a>
    <button id="sidebar-open-btn" aria-label="Abrir menú">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Backdrop (mobile overlay) ─────────────────────────────── -->
  <div id="sidebar-backdrop" class="sidebar-backdrop"></div>

  <!-- Sidebar panel ─────────────────────────────────────────── -->
  <nav id="sidebar-panel" class="sidebar-panel" aria-label="Navegación principal">

    <!-- Close button (mobile only) -->
    <button id="sidebar-close-btn" class="sidebar-close" aria-label="Cerrar menú">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Avatar + Brand ──────────────────────── -->
    <div class="sidebar-brand">
      <a href={`${base}/`} class="avatar-link" aria-label="Inicio">
        <div class="avatar">
          <span class="avatar-initials font-mono">CSPR</span>
          <span class="avatar-glow"></span>
        </div>
      </a>
      <div class="brand-info">
        <a href={`${base}/`} class="brand-link" aria-label="Inicio">
          <span class="brand-name">
            <span class="brand-first">Carlos</span><span class="brand-last"> Patiño</span>
          </span>
          <span class="brand-tag">sec</span>
        </a>
        <p class="brand-role font-mono">Ing. Sistemas · Ciberseg.</p>
        <div class="status-row">
          <span class="status-dot"></span>
          <span class="status-text font-mono">disponible</span>
        </div>
      </div>
    </div>

    <div class="sidebar-divider"></div>

    <!-- Nav links ───────────────────────────── -->
    <p class="nav-section-label font-mono">// navegación</p>
    <ul class="sidebar-nav" role="list">
      {navLinks.map(link => {
        const resolvedHref = link.href === '/' ? `${base}/` : `${base}${link.href}`;
        const isActive = link.href === '/'
          ? (currentPath === `${base}/` || currentPath === `${base}` || currentPath === `${base}/index`)
          : currentPath.startsWith(`${base}${link.href}`);
        return (
          <li>
            <a href={resolvedHref} class={`sidebar-link font-mono${isActive ? ' sidebar-link-active' : ''}`}>
              {link.icon === 'home' && (
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/>
                </svg>
              )}
              {link.icon === 'folder' && (
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/>
                </svg>
              )}
              {link.icon === 'terminal' && (
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z"/>
                </svg>
              )}
              <span>{link.label}</span>
              {link.count !== null && (
                <span class="nav-count font-mono">{link.count}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="sidebar-spacer"></div>
    <div class="sidebar-divider"></div>

    <!-- Social links ────────────────────────── -->
    <p class="nav-section-label font-mono">// redes</p>
    <div class="sidebar-social">
      <a href="https://github.com/SantiagoP0815" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
        <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        <span class="font-mono">GitHub</span>
      </a>
      <a href="https://linkedin.com/in/carlos-santiago-patino-reyes" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
        <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="font-mono">LinkedIn</span>
      </a>
    </div>

  </nav>
</aside>

<style>
  /* ── Sidebar panel (desktop) ──────────────────────────────── */
  .sidebar-panel {
    position: fixed;
    top: 0; left: 0;
    width: 240px;
    height: 100vh;
    background: var(--color-bg-secondary);
    border-right: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    z-index: 100;
    overflow-y: auto;
  }

  /* ── Avatar ──────────────────────────────────────────────── */
  .avatar-link { display: block; text-decoration: none; }
  .avatar {
    position: relative;
    width: 52px; height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(34,211,238,0.15), rgba(167,139,250,0.15));
    border: 1.5px solid rgba(34,211,238,0.35);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.2s;
  }
  .avatar:hover { border-color: rgba(34,211,238,0.65); }
  .avatar-initials {
    font-size: 0.8rem; font-weight: 700;
    color: var(--color-neon-cyan);
    letter-spacing: 0.04em;
  }
  .avatar-glow {
    position: absolute; inset: -2px;
    border-radius: 50%;
    box-shadow: 0 0 14px rgba(34,211,238,0.12);
    pointer-events: none;
  }

  /* ── Brand ────────────────────────────────────────────────── */
  .sidebar-brand {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-bottom: 0.25rem;
  }
  .brand-info {
    display: flex; flex-direction: column; gap: 0.25rem;
    min-width: 0;
  }
  .brand-link {
    display: inline-flex; align-items: center; gap: 0.45rem;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-sans);
    font-weight: 700; font-size: 0.88rem;
    letter-spacing: -0.02em;
  }
  .brand-first { color: var(--color-text-primary); }
  .brand-last  { color: var(--color-neon-cyan); }
  .brand-tag {
    font-family: var(--font-mono); font-size: 0.58rem; font-weight: 600;
    color: var(--color-neon-cyan);
    background: rgba(34,211,238,0.08);
    border: 1px solid rgba(34,211,238,0.25);
    padding: 0.08rem 0.35rem; border-radius: 4px;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .brand-role {
    font-size: 0.65rem; color: var(--color-text-muted);
    line-height: 1.3;
  }
  .status-row {
    display: flex; align-items: center; gap: 0.4rem;
  }
  .status-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-neon-green);
    box-shadow: 0 0 6px var(--color-neon-green);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  .status-text {
    font-size: 0.66rem; color: var(--color-neon-green); opacity: 0.75;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.45; }
  }

  /* ── Nav section labels ───────────────────────────────────── */
  .nav-section-label {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    padding: 0 0.75rem;
    margin-bottom: 0.25rem;
    opacity: 0.6;
  }

  /* ── Divider ──────────────────────────────────────────────── */
  .sidebar-divider {
    height: 1px;
    background: var(--color-border-subtle);
    margin: 0.75rem 0;
  }

  /* ── Nav links ────────────────────────────────────────────── */
  .sidebar-nav {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .sidebar-link {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.82rem;
    transition: background 0.18s, color 0.18s;
  }
  .sidebar-link:hover {
    background: rgba(255,255,255,0.04);
    color: var(--color-text-primary);
  }
  .sidebar-link-active {
    color: var(--color-neon-cyan) !important;
    background: rgba(34,211,238,0.08) !important;
  }
  .sidebar-link svg { flex-shrink: 0; opacity: 0.8; }
  .sidebar-link-active svg { opacity: 1; }
  .nav-count {
    margin-left: auto;
    font-size: 0.62rem;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: rgba(34,211,238,0.08);
    border: 1px solid rgba(34,211,238,0.18);
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .sidebar-link-active .nav-count {
    background: rgba(34,211,238,0.14);
    border-color: rgba(34,211,238,0.35);
    color: var(--color-neon-cyan);
  }

  /* ── Spacer + Social ──────────────────────────────────────── */
  .sidebar-spacer { flex: 1; }

  .sidebar-social {
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .social-link {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.5rem 0.75rem; border-radius: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.75rem;
    transition: color 0.18s, background 0.18s;
  }
  .social-link:hover {
    color: var(--color-text-primary);
    background: rgba(255,255,255,0.04);
  }

  /* ── Close button (mobile only, hidden on desktop) ────────── */
  .sidebar-close {
    display: none;
    position: absolute; top: 1rem; right: 1rem;
    background: transparent; border: none;
    color: var(--color-text-secondary); cursor: pointer;
    padding: 0.35rem; border-radius: 0.375rem;
  }
  .sidebar-close:hover { color: var(--color-text-primary); background: rgba(255,255,255,0.05); }

  /* ── Mobile top bar (hidden on desktop) ───────────────────── */
  .mobile-topbar { display: none; }

  /* ── Backdrop (hidden on desktop) ────────────────────────── */
  .sidebar-backdrop {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(2px);
    z-index: 99;
    opacity: 0;
    transition: opacity 0.25s;
  }

  /* ── Mobile overrides ─────────────────────────────────────── */
  .mobile-brand {
    display: inline-flex; align-items: center; gap: 0.45rem;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    /* Top bar */
    .mobile-topbar {
      display: flex; align-items: center; justify-content: space-between;
      position: fixed; top: 0; left: 0; right: 0; height: 56px;
      padding: 0 1.25rem;
      background: rgba(8,13,18,0.92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--color-border-subtle);
      z-index: 101;
    }
    .mobile-topbar button {
      background: transparent; border: none;
      color: var(--color-text-secondary); cursor: pointer;
      padding: 0.4rem; border-radius: 0.375rem;
    }
    .mobile-topbar button:hover { color: var(--color-text-primary); }

    /* Sidebar panel: hidden, slides in */
    .sidebar-panel {
      z-index: 103;
      transform: translateX(-100%);
      transition: transform 0.28s ease;
    }
    .sidebar-panel.sidebar-open {
      transform: translateX(0);
    }

    /* Close button visible */
    .sidebar-close { display: flex; }

    /* Backdrop */
    .sidebar-backdrop {
      display: block;
      pointer-events: none;
      z-index: 102;
    }
    .sidebar-backdrop.backdrop-visible {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  const openBtn    = document.getElementById('sidebar-open-btn');
  const closeBtn   = document.getElementById('sidebar-close-btn');
  const backdrop   = document.getElementById('sidebar-backdrop');
  const panel      = document.getElementById('sidebar-panel');

  function openSidebar() {
    panel?.classList.add('sidebar-open');
    backdrop?.classList.add('backdrop-visible');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    panel?.classList.remove('sidebar-open');
    backdrop?.classList.remove('backdrop-visible');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  backdrop?.addEventListener('click', closeSidebar);
</script>
